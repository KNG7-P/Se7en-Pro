# =====================================================================
#  Se7en Pro - .gitignore
# =====================================================================

# ---- Build output ----
[Bb]in/
[Oo]bj/
artifacts/
publish/
dist/
build_staging/
*.binlog
*.exe.config
TestResults/
Output/
installers/

# ---- Distribution & archive artifacts ----
*.zip
*.7z
*.tar.gz
*.msi
*.appinstaller
installer/Output/

# ---- Injected build secrets (NEVER commit) ----
Se7enPro/Services/BuildSecrets.g.cs
Se7enPro/Services/EmbeddedValues.plaintext.json

# ---- Sensitive / proprietary resources (NEVER commit) ----
# Psiphon propagation channel + sponsor configuration, in any form.
Se7enPro/Resources/server_entries.bin
Se7enPro/Resources/server_entries.txt
*.serverlist
# WARP / Aether device identity and WireGuard private keys.
*.toml
Se7enPro/Resources/aether/*.toml
Se7enFlutter/Resources/aether/*.toml

# ---- Flutter (legacy 1.0.4 UI, no longer part of the client) ----
Se7enFlutter/
**/flutter/ephemeral/

# ---- Visual Studio / Rider / VS Code / Android Studio ----
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.iml
UpgradeLog*.htm

# ---- Security, Certificates & Local Secrets (NEVER commit) ----
*.pfx
*.p12
*.cer
*.snk
*.key
*.pem
*.env
*.env.*
*.credentials
credentials.json
secrets.json
appsettings*.local.json
appsettings*.Development.json

# ---- Local agent / tooling state ----
.claude/
.gemini/
.kilo/
.agent/
scratch/
.scratch/
.cursorrules
AGENTS.md
GEMINI.md

# ---- Logs & runtime state ----
*.log

# ---- OS noise & temp ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.tmp
*.bak
*~

# ---- Linux / non-Windows leftovers ----
Se7enPro.Linux/
Resources_linux/
*.so
*.so.*

# ---- Python ----
__pycache__/
*.pyc
*.pyo