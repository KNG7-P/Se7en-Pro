# =====================================================================
#  Se7en Pro — .gitignore
# =====================================================================

# ---- Build & Staging Output ----
[Bb]in/
[Oo]bj/
artifacts/
publish/
build_staging/
*.binlog
*.exe.config
TestResults/
Output/
installers/

# ---- Distribution & Archive Artifacts ----
*.zip
*.7z
*.tar.gz

# ---- Flutter ----
Se7enFlutter/build/
Se7enFlutter/.dart_tool/
Se7enFlutter/.flutter-plugins-dependencies
windows/flutter/ephemeral/
**/windows/flutter/ephemeral/

# ---- Sensitive / Local Server Entries & Configurations ----
*.toml
server_entries.bin
server_entries.txt
Se7enPro/Resources/server_entries.bin
Se7enPro/Resources/server_entries.txt
Se7enPro/Resources/aether/*.toml
Se7enFlutter/Resources/aether/*.toml

# ---- Visual Studio / Rider / VS Code / Android Studio ----
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.iml
UpgradeLog*.htm

# ---- AI Agents & Local Tooling State ----
.cursorrules
AGENTS.md
GEMINI.md
.claude/
.kilo/
.gemini/
.agent/
tools/
Se7enPro/tools/

# ---- Logs & Runtime State ----
*.log

# ---- OS Noise & Temp ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.bak

# ---- Python ----
__pycache__/
*.pyc
*.pyo
