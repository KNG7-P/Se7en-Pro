# =====================================================================
#  Se7en Pro — .gitignore
#  The repo tracks the WPF C# client (Se7enPro/) and everything it
#  needs to build & run, including the bundled engine binaries under
#  Se7enPro/Resources. Build output and local tooling state stay out.
# =====================================================================

# ---- Build output ----
[Bb]in/
[Oo]bj/
artifacts/
publish/
*.binlog
*.exe.config

# ---- Visual Studio / Rider / VS Code ----
.vs/
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
UpgradeLog*.htm

# ---- Local agent / tooling state ----
.claude/

# ---- Logs & runtime state ----
*.log

# ---- OS noise ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Temp / test output ----
*.tmp
TestResults/
*.bak
# ---- Secrets & Server Lists ----
Se7enPro/Resources/server_entries.txt
Se7enPro/Resources/server_entries.bin
Se7enPro/Resources/aether/*.toml
Se7enPro/Services/EmbeddedValues.plaintext.json
*.toml
