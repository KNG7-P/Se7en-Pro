<UserControl x:Class="Se7enPro.Views.Dialogs.ConfigModalsHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Se7enPro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <Grid>
        <Border x:Name="ResetSettingsOverlay" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Background="{DynamicResource Brand.ScrimBrush}" Visibility="{Binding IsResetSettingsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <Border Width="400" Background="{DynamicResource Surface.CardElevated}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" CornerRadius="16" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Status.DangerSoft}" BorderBrush="{DynamicResource Status.DangerBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="22" Height="22" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_ResetSettings2}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Restorefactorydefaults}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource UI.ModalCloseButton}" Command="{Binding CloseResetSettingsDialogCommand}" ToolTip="{DynamicResource Loc_close}" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Loc_close}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>

                
                <TextBlock Text="{DynamicResource Loc_Areyousureyouwanttoresetallsetting}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,22" />

                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource UI.GhostButton}" Content="{DynamicResource Loc_dialogCancel}" FontWeight="SemiBold" Command="{Binding CloseResetSettingsDialogCommand}" />

                    <Button Grid.Column="2" Style="{StaticResource UI.DangerButton}" Content="{DynamicResource Loc_resetSettingsShort}" FontWeight="Bold" Command="{Binding ConfirmResetSettingsCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>

    
        <Border x:Name="ClearAllConfigsOverlay" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Background="{DynamicResource Brand.ScrimBrush}" Visibility="{Binding IsClearAllConfigsDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <Border Width="400" Background="{DynamicResource Surface.CardElevated}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" CornerRadius="16" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Status.DangerSoft}" BorderBrush="{DynamicResource Status.DangerBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="22" Height="22" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_ClearConfigurations}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Removeallproxyprofiles}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource UI.ModalCloseButton}" Command="{Binding CloseClearAllConfigsDialogCommand}" ToolTip="{DynamicResource Loc_close}" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Loc_close}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>

                <TextBlock Text="{DynamicResource Loc_Areyousureyouwanttoremoveallsavedp}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,22" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource UI.GhostButton}" Content="{DynamicResource Loc_dialogCancel}" FontWeight="SemiBold" Command="{Binding CloseClearAllConfigsDialogCommand}" />

                    <Button Grid.Column="2" Style="{StaticResource UI.DangerButton}" Content="{DynamicResource Loc_clearAllRules}" FontWeight="Bold" Command="{Binding ConfirmClearAllConfigsCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Border>

    
        <Border x:Name="ImportConfigsOverlay" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Background="{DynamicResource Brand.ScrimBrush}" Visibility="{Binding IsImportDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <Border Width="480" MaxHeight="600" Background="{DynamicResource Surface.CardElevated}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" CornerRadius="16" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="#20A855F7" BorderBrush="{DynamicResource Status.PurpleBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Link" Width="22" Height="22" Foreground="{DynamicResource AccentPurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc_ImportConfigurations}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_PasteproxylinksorsubscriptionURLs}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource UI.ModalCloseButton}" Command="{Binding CloseImportDialogCommand}" ToolTip="{DynamicResource Loc_close}" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Loc_close}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>

                <TextBlock Grid.Row="1" Text="{DynamicResource Loc_Supportsvlessvmesstrojansshysteria}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8" />

                
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <TextBox Style="{StaticResource UI.MultilineTextBox}" MinHeight="200" Padding="12,10,48,10" AutomationProperties.Name="{DynamicResource Loc_ImportConfigurations}" materialDesign:HintAssist.Hint="vless://...  &#x2022;  vmess://...  &#x2022;  https://subscription" Text="{Binding ImportLinkText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Style="{StaticResource UI.GhostButton}" MinWidth="0" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,12,0" Command="{Binding PasteImportFromClipboardCommand}" ToolTip="{DynamicResource Loc_PastefromClipboard}" AutomationProperties.Name="{DynamicResource Loc_PastefromClipboard}">
                        <materialDesign:PackIcon Kind="ContentPaste" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                


                
                <TextBlock Grid.Row="4" Text="{Binding ImportErrorText}" Visibility="{Binding HasImportError, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12" />

                
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource UI.GhostButton}" Content="{DynamicResource Loc_dialogCancel}" FontWeight="SemiBold" Command="{Binding CloseImportDialogCommand}" />

                    <Button Grid.Column="2" Style="{StaticResource UI.PrimaryButton}" Content="{DynamicResource Loc_ImportNodes}" FontWeight="Bold" Command="{Binding ConfirmImportCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Border>

    
        <Border x:Name="AddEditConfigOverlay" IsVisibleChanged="AddEditConfigOverlay_IsVisibleChanged" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle" Background="{DynamicResource Brand.ScrimBrush}" Visibility="{Binding IsAddEditConfigDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        <Border Width="520" MaxHeight="620" Background="{DynamicResource Surface.CardElevated}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" CornerRadius="16" Padding="22,18" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Status.CyanSoft}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Server" Width="18" Height="18" Foreground="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AddEditConfigDialogTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource Loc_Configureproxynodeparameters}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource UI.ModalCloseButton}" Command="{Binding CloseAddEditConfigDialogCommand}" ToolTip="{DynamicResource Loc_close}" VerticalAlignment="Top" AutomationProperties.Name="{DynamicResource Loc_close}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </Grid>

                
                <ScrollViewer Grid.Row="1" x:Name="AddEditConfigScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" MaxHeight="450">
                    <StackPanel Margin="0,0,10,0">
                        
                        <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_v2rayProtocol}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditProtocolCommand}" CommandParameter="vless" AutomationProperties.Name="VLESS">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                        <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditConfigProtocol}" Value="vless">
                                                <Setter Property="Background" Value="{DynamicResource Status.CyanSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="VLESS" FontSize="11" />
                            </Button>

                            <Button Grid.Column="2" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditProtocolCommand}" CommandParameter="vmess" AutomationProperties.Name="VMess">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                        <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditConfigProtocol}" Value="vmess">
                                                <Setter Property="Background" Value="{DynamicResource Status.PurpleSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentPurpleBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentPurpleBrush}" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="VMess" FontSize="11" />
                            </Button>

                            <Button Grid.Column="4" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditProtocolCommand}" CommandParameter="trojan" AutomationProperties.Name="Trojan">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                        <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditConfigProtocol}" Value="trojan">
                                                <Setter Property="Background" Value="#26F59E0B" />
                                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Trojan" FontSize="11" />
                            </Button>

                            <Button Grid.Column="6" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditProtocolCommand}" CommandParameter="shadowsocks" AutomationProperties.Name="SS">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                        <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditConfigProtocol}" Value="shadowsocks">
                                                <Setter Property="Background" Value="#2622C55E" />
                                                <Setter Property="BorderBrush" Value="#22C55E" />
                                                <Setter Property="Foreground" Value="#22C55E" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="SS" FontSize="11" />
                            </Button>

                            <Button Grid.Column="8" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditProtocolCommand}" CommandParameter="hysteria2" AutomationProperties.Name="HY2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                        <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditConfigProtocol}" Value="hysteria2">
                                                <Setter Property="Background" Value="#26EC4899" />
                                                <Setter Property="BorderBrush" Value="#EC4899" />
                                                <Setter Property="Foreground" Value="#EC4899" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="HY2" FontSize="11" />
                            </Button>
                        </Grid>

                        
                        <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_PROFILENAME}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_egFrankfurtHighSpeed}" Height="38" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Loc_PROFILENAME}" />

                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_v2rayServerAddress}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigAddress, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_egexamplecomor1234}" Height="38" AutomationProperties.Name="{DynamicResource Loc_v2rayServerAddress}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_v2rayPort}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="443" Height="38" HorizontalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_v2rayPort}" />
                            </StackPanel>
                        </Grid>

                        
                        <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_USERIDUUIDPASSWORD}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigUserId, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_UUIDorpasswordkey}" Height="38" Margin="0,0,0,10" AutomationProperties.Name="{DynamicResource Loc_USERIDUUIDPASSWORD}" />

                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_SECURITY}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditSecurityCommand}" CommandParameter="reality" AutomationProperties.Name="Reality">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                                <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditConfigSecurity}" Value="reality">
                                                        <Setter Property="Background" Value="{DynamicResource Status.PurpleSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPurpleBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentPurpleBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="Reality" FontSize="10.5" />
                                    </Button>
                                    <Button Grid.Column="2" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditSecurityCommand}" CommandParameter="tls" AutomationProperties.Name="TLS">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                                <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditConfigSecurity}" Value="tls">
                                                        <Setter Property="Background" Value="{DynamicResource Status.CyanSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="TLS" FontSize="10.5" />
                                    </Button>
                                    <Button Grid.Column="4" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditSecurityCommand}" CommandParameter="none" AutomationProperties.Name="{DynamicResource Loc_None}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                                <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditConfigSecurity}" Value="none">
                                                        <Setter Property="Background" Value="#2094A3B8" />
                                                        <Setter Property="BorderBrush" Value="#94A3B8" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{DynamicResource Loc_None}" FontSize="10.5" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_tabNetwork}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditNetworkCommand}" CommandParameter="tcp" AutomationProperties.Name="TCP">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                                <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditConfigNetwork}" Value="tcp">
                                                        <Setter Property="Background" Value="{DynamicResource Status.CyanSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="TCP" FontSize="10.5" />
                                    </Button>
                                    <Button Grid.Column="2" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditNetworkCommand}" CommandParameter="ws" AutomationProperties.Name="WS">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                                <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditConfigNetwork}" Value="ws">
                                                        <Setter Property="Background" Value="{DynamicResource Status.CyanSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="WS" FontSize="10.5" />
                                    </Button>
                                    <Button Grid.Column="4" Height="30" Padding="0" MinWidth="0" Command="{Binding SetEditNetworkCommand}" CommandParameter="grpc" AutomationProperties.Name="gRPC">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UI.GhostButton}">
                                                <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditConfigNetwork}" Value="grpc">
                                                        <Setter Property="Background" Value="{DynamicResource Status.CyanSoft}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="gRPC" FontSize="10.5" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        
                        <StackPanel Visibility="{Binding IsTlsOrRealitySecurity, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_SNISERVERNAME}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigSni, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_egwwwcloudflarecom}" Height="38" AutomationProperties.Name="{DynamicResource Loc_SNISERVERNAME}" />
                        </StackPanel>

                        
                        <StackPanel Visibility="{Binding IsWsOrGrpcNetwork, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_HostHeader}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigHost, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_egwwwcloudflarecom}" Height="38" AutomationProperties.Name="{DynamicResource Loc_HostHeader}" />
                        </StackPanel>

                        
                        <Grid Visibility="{Binding IsRealitySecurity, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_REALITYPUBLICKEY}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigPublicKey, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_Base64publickey}" Height="38" AutomationProperties.Name="{DynamicResource Loc_REALITYPUBLICKEY}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_v2rayShortId}" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigShortId, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_HexshortID}" Height="38" AutomationProperties.Name="{DynamicResource Loc_HexshortID}" />
                            </StackPanel>
                        </Grid>

                        
                        <StackPanel Visibility="{Binding IsWsOrGrpcNetwork, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_PATHSERVICENAME}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource UI.CustomTextBox}" Text="{Binding EditConfigPath, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="/path or grpc-service" Height="38" AutomationProperties.Name="{DynamicResource Loc_PATHSERVICENAME}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="{Binding EditConfigFormError}" Visibility="{Binding HasEditConfigFormError, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,12" />

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource UI.GhostButton}" Content="{DynamicResource Loc_dialogCancel}" FontWeight="SemiBold" Command="{Binding CloseAddEditConfigDialogCommand}" />

                    <Button Grid.Column="2" Style="{StaticResource UI.PrimaryButton}" Content="{DynamicResource Loc_SaveConfiguration}" FontWeight="Bold" Command="{Binding SaveAddEditConfigCommand}" />
                </Grid>
            </Grid>
        </Border>
    </Border>
    </Grid>
</UserControl>
