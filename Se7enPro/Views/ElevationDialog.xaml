<Window x:Class="Se7enPro.Views.ElevationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Title="{DynamicResource Loc_Administratorprivilegesrequired}" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="{StaticResource UI.FontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Surface.CardElevated}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" CornerRadius="18" Padding="22,20" Margin="12">

        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Background="#1CF59E0B" BorderBrush="#50F59E0B" BorderThickness="1" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="ShieldLockOutline" Width="22" Height="22" Foreground="{StaticResource Brand.WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Administratorprivilegesrequired}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_SystemwidetunnelingneedsAdministra2}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Loc_WouldyouliketorestartSe7enProasAdm}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />

            <Border Height="1" Background="{DynamicResource Surface.CardBorder}" Margin="0,0,0,14" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Style="{StaticResource UI.GhostButton}" Content="{DynamicResource Loc_dialogCancel}" MinWidth="96" Margin="0,0,10,0" Click="OnCancelClicked" IsCancel="True" />

                <Button Grid.Column="2" x:Name="ElevateButton" Style="{StaticResource UI.PrimaryButton}" MinWidth="190" Click="OnElevateClicked">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Shield" Width="14" Height="14" Foreground="{DynamicResource TextOnCyanBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{DynamicResource Loc_restartAsAdministrator}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextOnCyanBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
