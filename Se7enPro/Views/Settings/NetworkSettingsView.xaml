<UserControl x:Class="Se7enPro.Views.Settings.NetworkSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Se7enPro.Converters"
             xmlns:svc="clr-namespace:Se7enPro.Services"
             xmlns:vm="clr-namespace:Se7enPro.ViewModels"
             xmlns:controls="clr-namespace:Se7enPro.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
            <StackPanel>
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsNetworkTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_sectionNetworkRouting}" />
                        </StackPanel>
                    </Grid>

                    
                    <Border Padding="0,9" Margin="0,2,0,2">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Loc_killSwitch}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_BlockinternetaccessifVPNdisconnect}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_killSwitch}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding KillSwitchEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Border Padding="0,9" Margin="0,2,0,2">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Loc_autoReconnect}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_autoReconnectDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_autoReconnect}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AutoReconnect, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsNetworkTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                            <materialDesign:PackIcon Kind="Lan" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_sectionLocalProxy}" />
                            <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_localProxySubtitle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    
                    <Border Padding="0,9">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Loc_customProxyPorts}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_ManualSOCKS5HTTPportsoffauto}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            
                            <Border Grid.Column="1" Visibility="{Binding UseCustomProxyPorts, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Background="#2034D399" BorderBrush="#5034D399" BorderThickness="1" CornerRadius="6" Padding="8,3.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_DefaultAuto}" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" />
                            </Border>

                            <ToggleButton Grid.Column="2" AutomationProperties.Name="{DynamicResource Loc_customProxyPorts}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding UseCustomProxyPorts, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Border Margin="0,6,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource Surface.SubtleBg}" Visibility="{Binding UseCustomProxyPorts, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Surface.SubtleBorder}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPortProblem}" Value="True">
                                        <Setter Property="BorderThickness" Value="1.4" />
                                        <Setter Property="BorderBrush" Value="#CCEF4444" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource Status.CyanSoft}" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="Tune" Width="13" Height="13" Foreground="{StaticResource Brand.AccentBrush}" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc_customPortAssignment}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource Surface.CardBg}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_autoAssignZero}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                
                                <StackPanel Grid.Column="0">
                                    <Grid Margin="0,0,0,7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="EthernetCable" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{DynamicResource Loc_socks5Port}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="5" Padding="5,1.5">
                                            <TextBlock Text="1–65535" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42" Text="{Binding SocksPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_108080Auto}" AutomationProperties.Name="{DynamicResource Loc_108080Auto}" />
                                </StackPanel>

                                
                                <StackPanel Grid.Column="2">
                                    <Grid Margin="0,0,0,7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Web" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <TextBlock Text="{DynamicResource Loc_httpPort}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="5" Padding="5,1.5">
                                            <TextBlock Text="1–65535" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_108090Auto}" AutomationProperties.Name="{DynamicResource Loc_108090Auto}" />
                                </StackPanel>
                            </Grid>

                            
                            <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6" Background="{DynamicResource Status.DangerSoft}" BorderBrush="#60EF4444" BorderThickness="1" Visibility="{Binding HasPortProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding PortProblemText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Border Padding="0,9">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Loc_lanAccessAuth}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Requirecredentialsforlocalnetworkd}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_lanAccessAuth}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding LanAuthEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Border Margin="0,6,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Visibility="{Binding LanAuthEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#26A855F7" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="ShieldLockOutline" Width="13" Height="13" Foreground="#C084FC" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc_lanAccessAuth}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource Surface.CardBg}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_optionalBadge}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <materialDesign:PackIcon Kind="AccountOutline" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_lanUsername}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42" Text="{Binding LanProxyUsername, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_Username}" AutomationProperties.Name="{DynamicResource Loc_lanUsername}" />
                                </StackPanel>

                                
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <materialDesign:PackIcon Kind="LockOutline" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_lanPassword}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <PasswordBox Style="{StaticResource UI.CustomPasswordBox}" Height="42" Loaded="OnLanProxyPasswordBoxLoaded" materialDesign:HintAssist.Hint="{DynamicResource Loc_Password}" AutomationProperties.Name="{DynamicResource Loc_lanPassword}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    
                    <Border Padding="0,9">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Loc_allowLan}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_ShareproxywithdevicesonyourWiFiorL}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_allowLan}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AllowLanConnections, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Border Margin="0,6,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Visibility="{Binding AllowLanConnections, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#34D399" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc_lanEndpointsTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc_lanWifiClients}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                
                                <Border Grid.Row="0" Grid.Column="0" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanHostIp}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding HostLanIp}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopyHostIpCommand}" ToolTip="{DynamicResource Loc_CopyHostIP}" AutomationProperties.Name="{DynamicResource Loc_CopyHostIP}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHostIpCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>

                                
                                <Border Grid.Row="0" Grid.Column="2" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanSocks5Endpoint}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanSocksEndpoint}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopySocksEndpointCommand}" ToolTip="{DynamicResource Loc_CopySOCKS5Endpoint}" AutomationProperties.Name="{DynamicResource Loc_CopySOCKS5Endpoint}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSocksEndpointCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>

                                
                                <Border Grid.Row="2" Grid.Column="0" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanHttpEndpoint}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanHttpEndpoint}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopyHttpEndpointCommand}" ToolTip="{DynamicResource Loc_CopyHTTPProxyEndpoint2}" AutomationProperties.Name="{DynamicResource Loc_CopyHTTPProxyEndpoint2}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHttpEndpointCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>

                                
                                <Border Grid.Row="2" Grid.Column="2" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanAuthUserPass}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanAuthDisplay}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopyAuthCommand}" IsEnabled="{Binding HasLanAuthCredentials}" Visibility="{Binding HasLanAuthCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Loc_CopyAuthenticationCredentials}" AutomationProperties.Name="{DynamicResource Loc_CopyAuthenticationCredentials}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAuthCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsNetworkTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch">

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                            <materialDesign:PackIcon Kind="Dns" Width="16" Height="16"
                                                     Foreground="{StaticResource Brand.AccentBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{Binding Dns.Labels.CardTitle}"
                                           VerticalAlignment="Center" />
                                <Border Margin="9,0,0,0" Padding="8,2.5" CornerRadius="7" BorderThickness="1" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A00D4FF" />
                                            <Setter Property="BorderBrush" Value="#3D00D4FF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dns.HasAnyResolver}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Surface.SubtleBorder}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#00D4FF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dns.HasAnyResolver}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Dns.Summary}" FontSize="10" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#00D4FF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Dns.HasAnyResolver}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{Binding Dns.Labels.CardSubtitle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Dns.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DnsFieldRow}">
                                <Border Style="{StaticResource Aether.Row}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Aether.RowLabel}" Text="{Binding Label}" />
                                        <TextBox Margin="0,5,0,0" Style="{StaticResource UI.CustomTextBox}"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 materialDesign:HintAssist.Hint="{Binding Placeholder}"
                                                 FontFamily="{StaticResource UI.MonoFontFamily}"
                                                 ToolTip="{Binding Hint}"
                                                 AutomationProperties.Name="{Binding Label}" />
                                        <StackPanel Orientation="Horizontal" Margin="2,5,0,0"
                                                    Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="12" Height="12" Foreground="{DynamicResource WarningBrush}" Margin="0,1,5,0" />
                                            <TextBlock Text="{Binding Problem}" FontSize="10.5" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Aether.Row}" Margin="0,2,0,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Aether.RowLabel}">
                                            <Setter Property="Text" Value="{Binding Dns.Labels.StrictLabel}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dns.StrictMode}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Dns.Labels.StrictLabelOn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Aether.Hint}" Text="{Binding Dns.Labels.StrictHint}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{Binding Dns.Labels.StrictLabel}"
                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding Dns.StrictMode, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="10" Background="#20F59E0B"
                            BorderBrush="{DynamicResource Status.WarningBorder}" BorderThickness="1"
                            Visibility="{Binding Dns.HasTunnelWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Dns.Labels.TunnelWarning}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource WarningBrush}" />
                        </Grid>
                    </Border>

                    <Border Height="1" Margin="0,14,0,12" Background="{DynamicResource Surface.SubtleBorder}" Opacity="0.75" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Height="36" Padding="15,0" Margin="0,0,8,0"
                                Style="{StaticResource UI.Btn.Primary}"
                                Command="{Binding Dns.TestResolversCommand}"
                                IsEnabled="{Binding Dns.CanTest}"
                                AutomationProperties.Name="{Binding Dns.Labels.TestLabel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="Stethoscope" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Dns.IsTesting}" Value="True">
                                                    <Setter Property="Kind" Value="ProgressClock" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Text="{Binding Dns.Labels.TestLabel}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" Height="36" Padding="13,0"
                                Style="{StaticResource UI.Btn.Danger}"
                                Command="{Binding Dns.ResetCommand}"
                                AutomationProperties.Name="{Binding Dns.Labels.ResetLabel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Broom" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dns.Labels.ResetLabel}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Grid.Column="3" CornerRadius="9" Padding="9,4" Background="#1F34D399"
                                BorderBrush="#4034D399" BorderThickness="1" VerticalAlignment="Center"
                                Visibility="{Binding Dns.IsSavedFlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="13" Height="13" Foreground="#34D399" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Dns.Labels.AutoSaved}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="10" Background="{DynamicResource Status.DangerSoft}"
                            BorderBrush="#60EF4444" BorderThickness="1"
                            Visibility="{Binding Dns.HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource DangerBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Dns.ValidationMessage}" TextWrapping="Wrap" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                        </Grid>
                    </Border>

                    <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}"
                            BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1"
                            Visibility="{Binding Dns.HasTestResultToShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="FlaskOutline" Width="14" Height="14" Foreground="{StaticResource Brand.AccentBrush}" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="{Binding Dns.TestResult}" TextWrapping="Wrap" FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
            </StackPanel>
</UserControl>
