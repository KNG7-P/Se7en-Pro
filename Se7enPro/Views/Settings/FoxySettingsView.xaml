<UserControl x:Class="Se7enPro.Views.Settings.FoxySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Se7enPro.Converters"
             xmlns:svc="clr-namespace:Se7enPro.Services"
             xmlns:vm="clr-namespace:Se7enPro.ViewModels"
             xmlns:controls="clr-namespace:Se7enPro.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
            <StackPanel>
                
                <Border Style="{StaticResource Settings.Card}">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}" Background="{DynamicResource Status.FoxySoft}" BorderBrush="{DynamicResource Status.FoxyBorder}">
                                <materialDesign:PackIcon Kind="Firefox" Width="16" Height="16" Foreground="{DynamicResource Status.Foxy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_foxyAccountsTitle}" />
                                <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_foxyAccountsSubtitle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource UI.GhostButton}" Width="32" Height="32" Padding="0" Margin="0,0,8,0" Command="{Binding Foxy.RefreshAllQuotasCommand}" ToolTip="{DynamicResource Loc_foxyRefreshAll}" AutomationProperties.Name="{DynamicResource Loc_foxyRefreshAll}">
                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                                <Button Style="{StaticResource UI.PrimaryButton}" Padding="14,0" Height="32" VerticalAlignment="Center" Command="{Binding Foxy.AddAccountCommand}" AutomationProperties.Name="{DynamicResource Loc_foxyAddAccount}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{DynamicResource Loc_foxyAddAccount}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        
                        <Border Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="10" Padding="16,18" Visibility="{Binding Foxy.HasAccounts, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Firefox" Width="26" Height="26" Foreground="{DynamicResource Status.Foxy}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                <TextBlock Text="{DynamicResource Loc_foxyEmptyTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Loc_foxyEmptyBody}" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        
                        <ItemsControl ItemsSource="{Binding Foxy.Accounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Status.FoxySoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Firefox" Width="18" Height="18" Foreground="{DynamicResource Status.Foxy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Email}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <Border Margin="8,0,0,0" Padding="6,1.5" CornerRadius="4" Background="{DynamicResource Status.FoxySoft}" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{DynamicResource Loc_foxyActive}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Status.Foxy}" />
                                                        </Border>
                                                        <ProgressBar Width="12" Height="12" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Foreground="{DynamicResource Status.Foxy}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding LastCheckedText}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding QuotaResetDisplay}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource UI.GhostButton}" Height="26" Padding="9,0" Margin="0,0,6,0" Command="{Binding DataContext.Foxy.SetActiveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Loc_foxyMakeActive}" AutomationProperties.Name="{DynamicResource Loc_foxyMakeActive}" Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{DynamicResource Loc_foxyMakeActive}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Style="{StaticResource UI.GhostButton}" Width="28" Height="26" Padding="0" Margin="0,0,4,0" Command="{Binding DataContext.Foxy.RefreshQuotaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Loc_foxyRefreshQuota}" AutomationProperties.Name="{DynamicResource Loc_foxyRefreshQuota}">
                                                        <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Style="{StaticResource UI.GhostButton}" Width="28" Height="26" Padding="0" Command="{Binding DataContext.Foxy.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{DynamicResource Loc_foxyRemove}" AutomationProperties.Name="{DynamicResource Loc_foxyRemove}">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="13" Height="13" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            
                                            <Grid Margin="0,12,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding QuotaSummaryText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding QuotaUsedDisplay}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Height="6" Maximum="100" Value="{Binding QuotaRemainingPercentage, Mode=OneWay}" Foreground="{Binding QuotaProgressBarColor, Converter={StaticResource HexToBrush}}" Background="{DynamicResource Surface.SubtleBg}" AutomationProperties.Name="{DynamicResource Loc_foxyQuotaRemaining}">
                                                <ProgressBar.Template>
                                                    <ControlTemplate TargetType="ProgressBar">
                                                        <Grid>
                                                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" />
                                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </ProgressBar.Template>
                                            </ProgressBar>

                                            <Border Background="{DynamicResource Status.DangerSoft}" BorderBrush="{DynamicResource Status.DangerBorder}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,8,0,0" Visibility="{Binding HasQuotaError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="13" Height="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding QuotaErrorMessage}" FontSize="10.5" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Settings.Card}">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                <materialDesign:PackIcon Kind="CloudSync" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_upstreamProxyTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource UI.Btn.Danger}" Content="{DynamicResource Loc_shardClear}"
                                    Padding="12,0" FontSize="11.5" VerticalAlignment="Center"
                                    IsEnabled="{Binding Foxy.IsDirectFoxyOnly}"
                                    ToolTip="{DynamicResource Loc_Erasetheproxyhostportandcredential}"
                                    Command="{Binding Foxy.ClearCustomProxyCommand}" />
                        </Grid>

                        <Border Background="#18F59E0B" BorderBrush="{DynamicResource Status.WarningBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding Foxy.IsChainedFoxyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="InformationOutline" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Center" Foreground="#FBBF24" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource Loc_foxyProxyChainedDisabledWarning}"
                                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Padding="0,9" Visibility="{Binding Foxy.IsDirectFoxyOnly, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_upstreamProxyEnable}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{DynamicResource Loc_upstreamProxyEnableDescFoxy}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1"
                                              AutomationProperties.Name="{DynamicResource Loc_upstreamProxyEnable}"
                                              IsChecked="{Binding Foxy.CustomProxyEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding Foxy.IsDirectFoxyOnly}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Foxy.IsDirectFoxyOnly}" Value="True" />
                                                <Condition Binding="{Binding Foxy.CustomProxyEnabled}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Padding="0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_upstreamProxyScheme}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_upstreamProxySchemeDesc}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="230" Style="{StaticResource UI.CustomComboBox}"
                                              ItemsSource="{Binding Foxy.ProxySchemes}" DisplayMemberPath="Display" SelectedValuePath="Key"
                                              SelectedValue="{Binding Foxy.SelectedCustomProxyScheme, Mode=TwoWay}"
                                              AutomationProperties.Name="{DynamicResource Loc_upstreamProxyScheme}" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="125" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <materialDesign:PackIcon Kind="Dns" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_upstreamHost}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42"
                                             Text="{Binding Foxy.CustomProxyHost, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="127.0.0.1 or proxy.corp"
                                             AutomationProperties.Name="{DynamicResource Loc_upstreamHost}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <materialDesign:PackIcon Kind="Numeric" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_upstreamPort}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42"
                                             Text="{Binding Foxy.CustomProxyPort, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="1080"
                                             AutomationProperties.Name="{DynamicResource Loc_upstreamPort}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <materialDesign:PackIcon Kind="AccountOutline" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_upstreamAuthUser}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42"
                                             Text="{Binding Foxy.CustomProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="{DynamicResource Loc_optionalBadge}"
                                             AutomationProperties.Name="{DynamicResource Loc_upstreamAuthUser}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <materialDesign:PackIcon Kind="LockOutline" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_upstreamAuthPass}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <PasswordBox Style="{StaticResource UI.CustomPasswordBox}" Height="42"
                                                 materialDesign:HintAssist.Hint="{DynamicResource Loc_optionalBadge}"
                                                 Loaded="OnFoxyProxyPasswordBoxLoaded"
                                                 AutomationProperties.Name="{DynamicResource Loc_upstreamAuthPass}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
</UserControl>
