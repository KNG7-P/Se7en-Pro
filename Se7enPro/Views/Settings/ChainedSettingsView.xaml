                                                            <Button Style="{StaticResource UI.ModalCloseButton}" MinWidth="0" Width="24" Height="24" ToolTip="{DynamicResource Loc_v2rayDeletePrompt}" Command="{Binding DataContext.DeleteV2RayConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{DynamicResource Loc_v2rayDeletePrompt}">
                                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="12" Height="12" Foreground="{DynamicResource DangerBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                    </StackPanel>
            </StackPanel>
</UserControl>
