<UserControl x:Class="Se7enPro.Views.Settings.ChainedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Se7enPro.Converters"
             xmlns:svc="clr-namespace:Se7enPro.Services"
             xmlns:vm="clr-namespace:Se7enPro.ViewModels"
             xmlns:controls="clr-namespace:Se7enPro.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
            <StackPanel>
                    <StackPanel Visibility="{Binding IsChainedTab, Converter={StaticResource BooleanToVisibilityConverter}}">

                        
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_ChainedArchitecture2}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_Routeyourtrafficthroughmultihopcha}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_chainedMode}" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource UI.CustomComboBox}" ItemsSource="{Binding ChainedSubModes}" SelectedValue="{Binding SelectedChainedSubMode}" SelectedValuePath="Key" Height="38" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc_chainedMode}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <Border Grid.Column="1" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedPsiphonWarp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                        <materialDesign:PackIcon Kind="LayersOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodPsiphonOverWarp}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesPsiphonthroughanouterCloudfl}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_OUTERWARPTRANSPORT}" Margin="0,10,0,6" />
                                <ComboBox Style="{StaticResource UI.CustomComboBox}" ItemsSource="{Binding ChainedOuterTransports}" SelectedValue="{Binding SelectedChainedPsiphonOuterTransport}" SelectedValuePath="Key" DisplayMemberPath="Display" Height="38" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc_OUTERWARPTRANSPORT}" />

                                
                                <Border Margin="0,10,0,0" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_TransportDetails}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{DynamicResource Loc_AutoTryMASQUEthenWireGuardthenWoWr}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_MASQUEHTTP3fallingbacktoHTTP2withT}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WireGuardSingleWARPtunnelblockedon}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WoWWARPonWARPslowestforthemostfilt}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedTorWarp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                        <materialDesign:PackIcon Kind="ShieldMoon" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodTorOverWarp}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesTorthroughanouterWARPtunnelf}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_OUTERWARPTRANSPORT}" Margin="0,10,0,6" />
                                <ComboBox Style="{StaticResource UI.CustomComboBox}" ItemsSource="{Binding ChainedOuterTransports}" SelectedValue="{Binding SelectedChainedTorOuterTransport}" SelectedValuePath="Key" DisplayMemberPath="Display" Height="38" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc_OUTERWARPTRANSPORT}" />

                                
                                <Border Margin="0,10,0,0" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_TransportDetails}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{DynamicResource Loc_AutoTryMASQUEthenWireGuardthenWoWr}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_MASQUEHTTP3fallingbacktoHTTP2withT}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WireGuardSingleWARPtunnelblockedon}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WoWWARPonWARPslowestforthemostfilt}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedFoxyWarp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}" Background="{DynamicResource Status.FoxySoft}" BorderBrush="{DynamicResource Status.FoxyBorder}">
                                        <materialDesign:PackIcon Kind="Firefox" Width="16" Height="16" Foreground="{DynamicResource Status.Foxy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodFoxyOverWarp}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesFoxythroughanouterWARPtunnel}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_OUTERWARPTRANSPORT}" Margin="0,10,0,6" />
                                <ComboBox Style="{StaticResource UI.CustomComboBox}" ItemsSource="{Binding ChainedOuterTransports}" SelectedValue="{Binding SelectedChainedFoxyOuterTransport}" SelectedValuePath="Key" DisplayMemberPath="Display" Height="38" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc_OUTERWARPTRANSPORT}" />

                                <Border Margin="0,10,0,0" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_TransportDetails}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{DynamicResource Loc_AutoTryMASQUEthenWireGuardthenWoWr}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_MASQUEHTTP3fallingbacktoHTTP2withT}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WireGuardSingleWARPtunnelblockedon}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WoWWARPonWARPslowestforthemostfilt}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedLanternWarp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}" Background="#1AE11D48" BorderBrush="#40E11D48">
                                        <materialDesign:PackIcon Kind="RadioTower" Width="16" Height="16" Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodLanternOverWarp}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesLanternthroughanouterWARPtunne}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_OUTERWARPTRANSPORT}" Margin="0,10,0,6" />
                                <ComboBox Style="{StaticResource UI.CustomComboBox}" ItemsSource="{Binding ChainedOuterTransports}" SelectedValue="{Binding SelectedChainedLanternOuterTransport}" SelectedValuePath="Key" DisplayMemberPath="Display" Height="38" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc_OUTERWARPTRANSPORT}" />

                                <Border Margin="0,10,0,0" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_TransportDetails}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{DynamicResource Loc_AutoTryMASQUEthenWireGuardthenWoWr}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_MASQUEHTTP3fallingbacktoHTTP2withT}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WireGuardSingleWARPtunnelblockedon}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WoWWARPonWARPslowestforthemostfilt}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedVeepWarp, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}" Background="#1A3B82F6" BorderBrush="#403B82F6">
                                        <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodVeepOverWarp}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesVeepthroughanouterWARPtunne}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_OUTERWARPTRANSPORT}" Margin="0,10,0,6" />
                                <ComboBox Style="{StaticResource UI.CustomComboBox}" ItemsSource="{Binding ChainedOuterTransports}" SelectedValue="{Binding SelectedChainedVeepOuterTransport}" SelectedValuePath="Key" DisplayMemberPath="Display" Height="38" HorizontalAlignment="Stretch" AutomationProperties.Name="{DynamicResource Loc_OUTERWARPTRANSPORT}" />

                                <Border Margin="0,10,0,0" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_TransportDetails}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="{DynamicResource Loc_AutoTryMASQUEthenWireGuardthenWoWr}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_MASQUEHTTP3fallingbacktoHTTP2withT}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WireGuardSingleWARPtunnelblockedon}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                        <TextBlock Text="{DynamicResource Loc_WoWWARPonWARPslowestforthemostfilt}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        
                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedPsiphonFoxy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}" Background="#1AFF7139" BorderBrush="#40FF7139">
                                        <materialDesign:PackIcon Kind="Firefox" Width="16" Height="16" Foreground="#FF7139" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodPsiphonOverFoxy}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesPsiphonthroughanouterFoxytun}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Loc_FoxyPsiphonChainHint}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsChainedPsiphonLantern, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}" Background="#1AE11D48" BorderBrush="#40E11D48">
                                        <materialDesign:PackIcon Kind="RadioTower" Width="16" Height="16" Foreground="#E11D48" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_methodPsiphonOverLantern}" />
                                        <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_RoutesPsiphonthroughanouterLant}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{DynamicResource Loc_PsiphonLanternHint}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2" />
                            </StackPanel>
                        </Border>

                        
                        <StackPanel Visibility="{Binding IsChainedV2Ray, Converter={StaticResource BooleanToVisibilityConverter}}">

                            
                            <Border Style="{StaticResource Settings.Card}">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                            <materialDesign:PackIcon Kind="Cpu64Bit" Width="16" Height="16" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_v2rayCoreAndBridge}" />
                                            <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_Configureloopbackproxybridgeandant}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Padding="8,3" CornerRadius="6" Background="#2006B6D4" BorderBrush="#6006B6D4" BorderThickness="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Width="12" Height="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding V2RayCoreActiveBadge}" FontSize="11" FontWeight="SemiBold" Foreground="#06B6D4" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        
                                        <RadioButton Grid.Column="0" Style="{StaticResource UI.CardSelector}" IsChecked="{Binding IsXrayCoreSelected, Mode=OneWay}" Command="{Binding SelectXrayCoreCommand}" AutomationProperties.Name="{DynamicResource Loc_XrayCore}">
                                        <Border Padding="14,12" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Surface.SubtleBorder}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsXrayCoreSelected}" Value="True">
                                                            <Setter Property="Background" Value="#1A06B6D4" />
                                                            <Setter Property="BorderBrush" Value="#B006B6D4" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#2606B6D4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Flash" Width="18" Height="18" Foreground="#06B6D4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Loc_XrayCore}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border HorizontalAlignment="Left" Margin="0,2,0,0" Padding="6,1.5" CornerRadius="4" Background="#2606B6D4">
                                                        <TextBlock Text="Xray" FontSize="9.5" FontWeight="Bold" Foreground="#06B6D4" />
                                                    </Border>
                                                </StackPanel>
                                                <materialDesign:PackIcon Grid.Column="2" Kind="CheckCircle" Width="18" Height="18" Foreground="#06B6D4" VerticalAlignment="Center" Visibility="{Binding IsXrayCoreSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        </RadioButton>

                                        
                                        <RadioButton Grid.Column="2" Style="{StaticResource UI.CardSelector}" IsChecked="{Binding IsSingBoxCoreSelected, Mode=OneWay}" Command="{Binding SelectSingBoxCoreCommand}" AutomationProperties.Name="{DynamicResource Loc_SingBoxCore}">
                                        <Border Padding="14,12" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.SubtleBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Surface.SubtleBorder}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSingBoxCoreSelected}" Value="True">
                                                            <Setter Property="Background" Value="#1AA855F7" />
                                                            <Setter Property="BorderBrush" Value="#B0A855F7" />
                                                            <Setter Property="BorderThickness" Value="1.5" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#26A855F7" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Shield" Width="18" Height="18" Foreground="#A855F7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Loc_SingBoxCore}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border HorizontalAlignment="Left" Margin="0,2,0,0" Padding="6,1.5" CornerRadius="4" Background="#26A855F7">
                                                        <TextBlock Text="Sing-Box" FontSize="9.5" FontWeight="Bold" Foreground="#A855F7" />
                                                    </Border>
                                                </StackPanel>
                                                <materialDesign:PackIcon Grid.Column="2" Kind="CheckCircle" Width="18" Height="18" Foreground="#A855F7" VerticalAlignment="Center" Visibility="{Binding IsSingBoxCoreSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        </RadioButton>
                                    </Grid>

                                    <Border Height="1" Margin="0,16,0,14" Background="{DynamicResource Surface.SubtleBorder}" />

                                    <StackPanel Visibility="{Binding IsXrayCoreSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border Margin="0,0,0,10" Height="50" Padding="14,0" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" Kind="Dns" Width="16" Height="16" Foreground="#06B6D4" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{DynamicResource Loc_RouteDNSthroughV2Ray}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <ToggleButton Grid.Column="2" IsChecked="{Binding V2RayRouteDnsThroughV2Ray, Mode=TwoWay}" AutomationProperties.Name="{DynamicResource Loc_RouteDNSthroughV2Ray}" Style="{StaticResource MaterialDesignSwitchToggleButton}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Padding="12,10" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1F06B6D4" VerticalAlignment="Center" Margin="0,0,10,0">
