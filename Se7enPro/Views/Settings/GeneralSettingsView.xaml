<UserControl x:Class="Se7enPro.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Se7enPro.Converters"
             xmlns:svc="clr-namespace:Se7enPro.Services"
             xmlns:vm="clr-namespace:Se7enPro.ViewModels"
             xmlns:controls="clr-namespace:Se7enPro.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
            <StackPanel>
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="PaletteOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_sectionAppearanceLocale}" /></StackPanel>
                            </Grid>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_appearanceMode}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_appearanceModeDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Key" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_appearanceMode}" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_languageLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Selectyourpreferredapplicationlang}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Key" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_languageLabel}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_sectionSystemStartup}" /></StackPanel>
                            </Grid>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_autoConnectLaunch}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Automaticallyinitiatetunnelconnect}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_autoConnectLaunch}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AutoConnect, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_startWithWindows}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_LaunchSe7enProsilentlyatsystemstar}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_startWithWindows}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_MinimizetoTray2}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Keeprunninginbackgroundnotificatio}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_MinimizetoTray2}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_Whenclosingwindow}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Choosethedefaultactionwhenclicking}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding CloseActions}" SelectedItem="{Binding SelectedCloseAction}" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_Whenclosingwindow}" />
                                </Grid>
                            </Border>

                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_tunMethod}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_tunMethodDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding TunMethodOptions}" SelectedValue="{Binding SelectedTunMethod, Mode=TwoWay}" SelectedValuePath="Key" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_tunMethod}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_maintenanceTitle}" /></StackPanel>
                            </Grid>

                            
                            <Border Padding="12" Margin="0,0,0,10" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2400D4FF" BorderBrush="{DynamicResource Status.CyanBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Cached" Width="18" Height="18" Foreground="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Loc_resetCache}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_resetCacheDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource UI.Btn.Warning}" Padding="14,0" Command="{Binding ClearNetworkCacheCommand}" IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{DynamicResource Loc_resetCache}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Cached" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_resetCache}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            
                            <Border Padding="12" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#24EF4444" BorderBrush="{DynamicResource Status.DangerBorder}" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Loc_resetSettings}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_resetSettingsDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource UI.Btn.Danger}" Padding="12,0" Command="{Binding ShowResetSettingsDialogCommand}" ToolTip="{DynamicResource Loc_Resetallsettingstofactorydefaults}" AutomationProperties.Name="{DynamicResource Loc_resetSettingsShort}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_resetSettingsShort}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            
                            <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="8" Background="{DynamicResource Status.SuccessSoft}" BorderBrush="{DynamicResource Status.SuccessBorder}" BorderThickness="1" Visibility="{Binding IsMaintenanceToastOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding MaintenanceToastMessage}" AutomationProperties.LiveSetting="Assertive" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Settings.SectionIconBadge}">
                                    <materialDesign:PackIcon Kind="LayersTripleOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_UpdatesEngineCores}" />
                                    <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_Manageapplicationreleasesandunderl}" Margin="0,2,0,0" />
                                </StackPanel>

                                
                                <Button Grid.Column="2" Style="{StaticResource UI.Btn.Primary}" Padding="12,0" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_Checkforallapplicationandengineupd}" ToolTip="{DynamicResource Loc_Checkforallapplicationandengineupd}" Command="{Binding CheckAllUpdatesCommand}" IsEnabled="{Binding IsCheckingAllUpdates, Converter={StaticResource InverseBool}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Visibility="{Binding IsCheckingAllUpdates, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                        <ProgressBar Width="14" Height="14" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Visibility="{Binding IsCheckingAllUpdates, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Foreground="{StaticResource Brand.AccentBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_checkUpdates}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            
                            <StackPanel>
                                
                                <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#247C3AED" BorderBrush="#407C3AED" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ShieldLock" Width="18" Height="18" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_aboutTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                
                                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AppInstalledVersion, StringFormat='v{0}'}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                
                                                <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#3300D4FF" BorderBrush="#8C00D4FF" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding HasAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding AppLatestVersion, StringFormat='v{0}'}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AppUpdateStatusText}" FontSize="11" Foreground="{Binding AppUpdateStatusColor}" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.Name="{Binding AppUpdateStatusText}" AutomationProperties.LiveSetting="Assertive" />
                                        </StackPanel>

                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            
                                            <Button Style="{StaticResource UI.PrimaryButton}" Padding="12,0" Margin="0,0,6,0" Command="{Binding DownloadAppUpdateCommand}" Visibility="{Binding ShowAppDownload, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding AppUpdateActionText}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Download" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AppUpdateActionText}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource UI.SuccessButton}" Padding="12,0" Margin="0,0,6,0" Command="{Binding InstallAppUpdateCommand}" Visibility="{Binding ShowAppInstall, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding AppUpdateActionText}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="FolderUploadOutline" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AppUpdateActionText}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            
                                            <Button Style="{StaticResource UI.PrimaryButton}" Padding="12,0" Margin="0,0,6,0" IsEnabled="False" Visibility="{Binding ShowAppCancel, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding AppUpdateActionText}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ProgressBar Width="12" Height="12" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding AppUpdateActionText}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource UI.Btn.Danger}" Padding="10,0" Margin="0,0,6,0" Command="{Binding CancelAppUpdateDownloadCommand}" Visibility="{Binding ShowAppCancel, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{DynamicResource Loc_cancel}">
                                                <TextBlock Text="{DynamicResource Loc_cancel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Button>
                                            <Button Style="{StaticResource UI.PrimaryButton}" Padding="12,0" Margin="0,0,6,0" IsEnabled="False" Visibility="{Binding ShowAppInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{Binding AppUpdateActionText}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="Download" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding AppUpdateActionText}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            
                                            <Button Style="{StaticResource UI.Btn.Accent}" Padding="10,0" Margin="0,0,6,0" Command="{Binding OpenReleasesPageCommand}" Visibility="{Binding ShowAppReleases, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="{DynamicResource Loc_Releases}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource Loc_Releases}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            
                                            <Button Style="{StaticResource UI.Btn.Primary}" Width="30" Height="30" Padding="0" Command="{Binding CheckAppUpdateCommand}" AutomationProperties.Name="{DynamicResource Loc_Checkforapplicationupdate}" ToolTip="{DynamicResource Loc_Checkforapplicationupdate}" IsEnabled="{Binding IsAppUpdateBusy, Converter={StaticResource InverseBool}}">
                                                <Grid Width="14" Height="14">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Visibility="{Binding IsCheckingAppUpdate, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <ProgressBar Width="14" Height="14" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Visibility="{Binding IsCheckingAppUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource Brand.AccentBrush}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                        </Grid>

                                        
                                        <Grid Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding ShowAppUpdateProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="4" VerticalAlignment="Center" Value="{Binding AppUpdateProgress}" Maximum="100" Foreground="{StaticResource Brand.AccentBrush}" Background="{DynamicResource Surface.SubtleBg}" AutomationProperties.Name="{DynamicResource Loc_appUpdateProgress}" AutomationProperties.HelpText="{Binding AppUpdateProgressText}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AppUpdateProgressText}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                
                                <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        
                                        <Grid Grid.Row="0" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#1800E5FF" BorderBrush="#3300E5FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="CloudOutline" Width="18" Height="18" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Loc_AetherEngine}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AetherInstalledVersion}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Border Margin="6,0,0,0" Padding="6,2" CornerRadius="4" Background="#3300D4FF" BorderBrush="#8C00D4FF" BorderThickness="1" VerticalAlignment="Center" Visibility="{Binding HasAetherUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding AetherLatestVersion}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding AetherStatusText}" FontSize="11" Foreground="{Binding AetherStatusColor}" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.Name="{Binding AetherStatusText}" AutomationProperties.LiveSetting="Assertive" />
                                            </StackPanel>

                                            
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                
                                                <Button Style="{StaticResource UI.PrimaryButton}" Padding="12,0" Margin="0,0,6,0" Command="{Binding UpdateAetherCommand}" Visibility="{Binding HasAetherUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding IsUpdatingAether, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{DynamicResource Loc_Update}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="Download" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Loc_Update}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                
                                                <Button Style="{StaticResource UI.Btn.Warning}" Padding="10,0" Margin="0,0,6,0" ToolTip="{DynamicResource Loc_ReinstalllatestAethercore}" AutomationProperties.Name="{DynamicResource Loc_ReinstalllatestAethercore}" Command="{Binding ReinstallAetherCommand}" IsEnabled="{Binding IsUpdatingAether, Converter={StaticResource InverseBool}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Loc_reinstall}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                
                                                <Button Style="{StaticResource UI.Btn.Primary}" Width="30" Height="30" Padding="0" Command="{Binding CheckAetherUpdateCommand}" AutomationProperties.Name="{DynamicResource Loc_ChecklatestAetherversion}" ToolTip="{DynamicResource Loc_ChecklatestAetherversion}" IsEnabled="{Binding IsCheckingAetherUpdate, Converter={StaticResource InverseBool}}">
                                                    <Grid Width="14" Height="14">
                                                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Visibility="{Binding IsCheckingAetherUpdate, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                        <ProgressBar Width="14" Height="14" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Visibility="{Binding IsCheckingAetherUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource Brand.AccentBrush}" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        
                                        <Grid Grid.Row="1" Margin="0,10,0,2" Visibility="{Binding IsUpdatingAether, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0" Height="4" VerticalAlignment="Center" Value="{Binding AetherUpdateProgress}" Maximum="100" Foreground="{StaticResource Brand.AccentBrush}" Background="{DynamicResource Surface.SubtleBg}" AutomationProperties.Name="{DynamicResource Loc_aetherCoreUpdate}" AutomationProperties.HelpText="{Binding AetherStatusText}" />
                                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding AetherUpdateProgress, StringFormat={}{0}%}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                
                                <Border Padding="14,12" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#188A2BE2" BorderBrush="#338A2BE2" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="18" Height="18" Foreground="#BA68C8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource Loc_torCoreTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TorInstalledVersion}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TorStatusText}" FontSize="11" Foreground="{Binding TorStatusColor}" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.Name="{Binding TorStatusText}" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>

                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource UI.Btn.Primary}" Width="30" Height="30" Padding="0" Command="{Binding CheckTorUpdateCommand}" AutomationProperties.Name="{DynamicResource Loc_CheckTorcoreversion}" ToolTip="{DynamicResource Loc_CheckTorcoreversion}" IsEnabled="{Binding IsCheckingTorUpdate, Converter={StaticResource InverseBool}}">
                                                <Grid Width="14" Height="14">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Visibility="{Binding IsCheckingTorUpdate, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                                    <ProgressBar Width="14" Height="14" IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}" Visibility="{Binding IsCheckingTorUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" Foreground="{StaticResource Brand.AccentBrush}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
            </StackPanel>
</UserControl>
