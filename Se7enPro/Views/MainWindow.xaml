<Window x:Class="Se7enPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Se7enPro.ViewModels"
        xmlns:views="clr-namespace:Se7enPro.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Se7en Pro"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120" Height="740"
        MinWidth="940" MinHeight="620"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UI.FontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"
            NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootChromeBorder" Background="{DynamicResource Surface.AppBg}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource Surface.CardBorder}" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="ClipToBounds" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Height="40"
                    Background="{DynamicResource Surface.TitleBarBg}"
                    BorderBrush="{DynamicResource Surface.CardBorder}"
                    BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14,14,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="CornerRadius" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Grid.Column="0"
                                Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6"
                                Background="{StaticResource Brand.PrimarySoftBrush}"
                                BorderBrush="{StaticResource Brand.PrimaryBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldLockOutline"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{StaticResource Brand.PrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Se7en Pro" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="Transparent" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button Style="{StaticResource UI.TitleBarButton}"
                                ToolTip="Minimize"
                                Command="{Binding MinimizeWindowCommand}">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource UI.TitleBarButton}"
                                ToolTip="Maximize / Restore"
                                Command="{Binding MaximizeWindowCommand}">
                            <materialDesign:PackIcon Width="14" Height="14">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="WindowMaximize" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Kind" Value="WindowRestore" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <Button Style="{StaticResource UI.TitleBarCloseButton}"
                                ToolTip="Close"
                                Command="{Binding CloseWindowCommand}">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource Surface.SidebarBg}"
                        BorderBrush="{DynamicResource Surface.CardBorder}"
                        BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,0,0,14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="CornerRadius" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">

                        <Border DockPanel.Dock="Bottom" Padding="14,10" Opacity="0.6">
                            <TextBlock Text="v1.0.2  •  Windows Client"
                                       FontSize="10.5"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource UI.TelegramButton}"
                                Margin="12,6,12,6"
                                ToolTip="Open the King Network Telegram channel in your browser"
                                Command="{Binding OpenTelegramChannelCommand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="28" Height="28" CornerRadius="6"
                                        Background="#2BFFFFFF"
                                        VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Send" Width="15" Height="15"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            Margin="9,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="King Network"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock Text="@King_network7"
                                               FontSize="9.5" Opacity="0.85"
                                               Foreground="White"
                                               FontFamily="Cascadia Mono, Consolas, monospace" />
                                </StackPanel>
                                <materialDesign:PackIcon Grid.Column="2"
                                                          Kind="OpenInNew" Width="11" Height="11"
                                                          Opacity="0.8"
                                                          Foreground="White"
                                                          VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <ListBox ItemsSource="{Binding Pages}"
                                 SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,8,0,0"
                                 ItemContainerStyle="{StaticResource UI.NavItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                  Width="18" Height="18"
                                                                  VerticalAlignment="Center"
                                                                  Margin="2,0,10,0" />
                                        <TextBlock Text="{Binding Title}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource Surface.AppBg}"
                        ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,0,14,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="CornerRadius" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl x:Name="PageHost" />
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
