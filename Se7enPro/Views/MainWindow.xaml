<Window x:Class="Se7enPro.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:vm="clr-namespace:Se7enPro.ViewModels" xmlns:views="clr-namespace:Se7enPro.Views" xmlns:dialogs="clr-namespace:Se7enPro.Views.Dialogs" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="{DynamicResource Loc_aboutTitle}" Icon="pack://application:,,,/Assets/app.ico" Width="1000" Height="680" MinWidth="1000" MinHeight="680" MaxWidth="2560" MaxHeight="1440" SizeToContent="Manual" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" TextElement.Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource UI.FontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" RenderOptions.ClearTypeHint="Auto" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootChromeBorder" Background="{DynamicResource Surface.AppBackground}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource Surface.CardBorder}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="ClipToBounds" Value="True" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <DockPanel LastChildFill="True">

            
            <Border DockPanel.Dock="Top" Height="42" Background="{DynamicResource Surface.TitleBarBg}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="14,14,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="CornerRadius" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BrandColumn" Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    
                    <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.ColumnSpan="2" Margin="16,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentGradient}" BorderBrush="Transparent" BorderThickness="0" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldLockOutline" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                        </Border>
                        <TextBlock x:Name="BrandTitleText" Text="{DynamicResource Loc_aboutTitle}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    
                    <Border Grid.Column="1" Background="Transparent" />

                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">

                        <Button x:Name="SidebarToggleBtn" Style="{StaticResource UI.TitleBarButton}" ToolTip="Toggle sidebar" Click="OnToggleSidebarClicked" AutomationProperties.Name="Toggle sidebar">
                            <materialDesign:PackIcon Width="15" Height="15">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="MenuOpen" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" Value="True">
                                                <Setter Property="Kind" Value="Menu" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>

                        <Button Style="{StaticResource UI.ThemeToggleButton}" ToolTip="{DynamicResource Loc_Togglelightdarktheme}" Command="{Binding ToggleThemeCommand}" AutomationProperties.Name="{DynamicResource Loc_Togglelightdarktheme}">
                            <materialDesign:PackIcon Width="14" Height="14">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="WeatherSunny" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Kind" Value="WeatherNight" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>

                        <Button Style="{StaticResource UI.TitleBarButton}" ToolTip="{DynamicResource Loc_Minimize}" Command="{Binding MinimizeWindowCommand}" AutomationProperties.Name="{DynamicResource Loc_Minimize}">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource UI.TitleBarButton}" ToolTip="{DynamicResource Loc_MaximizeRestore}" Command="{Binding MaximizeWindowCommand}" AutomationProperties.Name="{DynamicResource Loc_MaximizeRestore}">
                            <materialDesign:PackIcon Width="14" Height="14">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="WindowMaximize" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Kind" Value="WindowRestore" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <Button Style="{StaticResource UI.TitleBarCloseButton}" ToolTip="{DynamicResource Loc_close}" Command="{Binding CloseWindowCommand}" AutomationProperties.Name="{DynamicResource Loc_close}">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                
                <Border Grid.Column="0" Background="{DynamicResource Surface.SidebarBg}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,0,0,14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="CornerRadius" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">

                        
                        <Border x:Name="SidebarVersionBorder" DockPanel.Dock="Bottom" Padding="14,10" Opacity="0.6">
                            <TextBlock Text="{Binding ClientVersionText}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>

                        
                        <Button DockPanel.Dock="Bottom" ToolTip="{DynamicResource Loc_OpentheKingNetworkTelegramchanneli}" Command="{Binding OpenTelegramChannelCommand}" AutomationProperties.Name="{DynamicResource Loc_OpentheKingNetworkTelegramchanneli}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource UI.TelegramButton}">
                                    <Setter Property="Margin" Value="14,8" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" Value="True">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Width" Value="46" />
                                            <Setter Property="Height" Value="46" />
                                            <Setter Property="Margin" Value="0,8,0,12" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="{StaticResource Brand.TelegramGradient}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Send" Width="15" Height="15" Foreground="{DynamicResource TextOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel x:Name="TelegramTextPanel" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="King Network" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="@King_network7" FontSize="9.5" Foreground="{DynamicResource Brand.TelegramBrush}" FontFamily="{StaticResource UI.MonoFontFamily}" />
                                </StackPanel>
                                <materialDesign:PackIcon x:Name="TelegramExternalIcon" Grid.Column="2" Kind="OpenInNew" Width="11" Height="11" Opacity="0.75" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        
                        <ListBox x:Name="NavListBox" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="0,14,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource UI.NavItem}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" Value="True">
                                            <Setter Property="Width" Value="46" />
                                            <Setter Property="Height" Value="46" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,4" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding Title}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="{Binding Icon}" VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon" BasedOn="{StaticResource UI.NavItemIcon}">
                                                    <Setter Property="Width" Value="18" />
                                                    <Setter Property="Height" Value="18" />
                                                    <Setter Property="Margin" Value="2,0,10,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}}" Value="True">
                                                            <Setter Property="Width" Value="20" />
                                                            <Setter Property="Height" Value="20" />
                                                            <Setter Property="Margin" Value="0" />
                                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="13" Visibility="{Binding IsSidebarCompact, RelativeSource={RelativeSource AncestorType=views:MainWindow}, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                
                <Border Grid.Column="1" Background="{DynamicResource Surface.AppBackground}" ClipToBounds="True">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,0,14,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="CornerRadius" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        
                        <Border DockPanel.Dock="Top" Padding="24,14,24,14">
                            <TextBlock Text="{Binding PageHeaderTitle}" FontSize="15" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Border>
                        <ContentControl x:Name="PageHost" />
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>

        
        <Border x:Name="ModalBackdropOverlay" Background="{DynamicResource Brand.ScrimBrush}" Visibility="Collapsed" IsHitTestVisible="True" Focusable="False" MouseDown="OnModalBackdropMouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

    
        <dialogs:ConfigModalsHost x:Name="ConfigModals" Panel.ZIndex="1000" />
    </Grid>
</Border>
</Window>
