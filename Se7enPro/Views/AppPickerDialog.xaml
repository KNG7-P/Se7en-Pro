<Window x:Class="Se7enPro.Views.AppPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Title="{DynamicResource Loc_Chooseapplications}" Width="640" Height="640" MinWidth="520" MinHeight="440" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="{StaticResource UI.FontFamily}" TextElement.Foreground="{DynamicResource TextPrimaryBrush}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Surface.CardElevated}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" CornerRadius="18" Padding="22,20,22,18" Margin="12">

        <DockPanel LastChildFill="True">

            
            <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="ApplicationOutline" Width="22" Height="22" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_Chooseapplications}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource Loc_Loadinginstalledapps}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource UI.ModalCloseButton}" VerticalAlignment="Top" ToolTip="{DynamicResource Loc_close}" Click="OnCancelClicked" AutomationProperties.Name="{DynamicResource Loc_close}">
                    <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" />
                </Button>
            </Grid>

            
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource UI.CustomTextBox}" Height="38" VerticalAlignment="Center" TextChanged="OnSearchTextChanged" materialDesign:HintAssist.Hint="{DynamicResource Loc_Searchbyappnameorexecutableegchrom}" AutomationProperties.Name="{DynamicResource Loc_Searchbyappnameorexecutableegchrom}" />
                <Button Grid.Column="2" Style="{StaticResource UI.GhostButton}" VerticalAlignment="Center" Padding="14,0" ToolTip="{DynamicResource Loc_Pickanexefilefromdisk}" Click="OnBrowseClicked" AutomationProperties.Name="{DynamicResource Loc_Browse}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{DynamicResource Loc_Browse}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            
            <Grid DockPanel.Dock="Bottom" Margin="0,16,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <CheckBox x:Name="MatchByPathCheckBox" Style="{StaticResource UI.DarkCheckBox}" Content="{DynamicResource Loc_Matchtheexactfilepathstricter}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" ToolTip="{DynamicResource Loc_Offmatchestheexecutablenamesotheru}" />
                    <TextBlock x:Name="SelectionText" Text="{DynamicResource Loc_Nothingselected}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="29,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource UI.DialogCancelButton}" Content="{DynamicResource Loc_dialogCancel}" Padding="18,0" MinWidth="88" Margin="0,0,10,0" VerticalAlignment="Center" Click="OnCancelClicked" IsCancel="True" />
                <Button Grid.Column="2" x:Name="AddButton" Style="{StaticResource UI.PrimaryButton}" Content="{DynamicResource Loc_Addselected}" Padding="20,0" MinWidth="118" VerticalAlignment="Center" IsEnabled="False" Click="OnAddClicked" IsDefault="True" />
            </Grid>

            
            <Grid>
                <Border BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BgInput}">
                    <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="10,3.5" Padding="14,10" CornerRadius="8" Background="{DynamicResource Surface.CardSecondaryBg}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="OnItemRowClicked">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        
                                        <CheckBox Grid.Column="0" Style="{StaticResource UI.DarkCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        
                                        <Border Grid.Column="1" Width="32" Height="32" CornerRadius="7" Background="{DynamicResource Surface.SubtleBg}" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>

                                        
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ExePath}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource UI.MonoFontFamily}" />
                                        </StackPanel>

                                        
                                        <Border Grid.Column="3" Padding="7,2.5" CornerRadius="5" VerticalAlignment="Center" Background="#1800D4FF" BorderBrush="#4000D4FF" BorderThickness="1" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{DynamicResource Loc_running}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brand.AccentBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                
                <materialDesign:PackIcon x:Name="BusyIcon" Kind="Loading" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85" Foreground="{StaticResource Brand.AccentBrush}" RenderTransformOrigin="0.5,0.5">
                    <materialDesign:PackIcon.RenderTransform>
                        <RotateTransform x:Name="BusySpin" />
                    </materialDesign:PackIcon.RenderTransform>
                    <materialDesign:PackIcon.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="BusySpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </materialDesign:PackIcon.Triggers>
                </materialDesign:PackIcon>
            </Grid>
        </DockPanel>
    </Border>
</Window>
