<UserControl x:Class="Se7enPro.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Se7enPro.Converters"
             xmlns:vm="clr-namespace:Se7enPro.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">

    <UserControl.Resources>
        <conv:StateToButtonTextConverter x:Key="StateToButtonText" />
        <conv:StateToBrushConverter x:Key="StateToBrush" />
        <conv:StateToConnectButtonBrushConverter x:Key="StateToConnectBrush" />
        <conv:StateToBadgeBackgroundConverter x:Key="StateToBadgeBg" />
        <conv:StateToBadgeBorderConverter x:Key="StateToBadgeBorder" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:CountryCodeToFlagSourceConverter x:Key="CountryCodeToFlag" />
        <conv:AutoRegionToVisibilityConverter x:Key="AutoRegionToVisibility" />
        <conv:NotAutoRegionToVisibilityConverter x:Key="NotAutoRegionToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,10,24,14" HorizontalAlignment="Stretch">

            <Border Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource UI.Card}">
                        <Setter Property="Padding" Value="20,14" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                <Setter Property="Padding" Value="24,24" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Stretch">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{Binding State, Converter={StaticResource StateToBadgeBg}}"
                                    BorderBrush="{Binding State, Converter={StaticResource StateToBadgeBorder}}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,3.5">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding StatusText}"
                                               Margin="7,0,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding ConnectingProgressText}"
                                       Visibility="{Binding ShowConnectingProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="380" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource TopBarEngineComboBox}"
                                  ItemsSource="{Binding ConnectionMethods}"
                                  SelectedValue="{Binding SelectedConnectionMethod}"
                                  SelectedValuePath="Key"
                                  DisplayMemberPath="Display"
                                  ToolTip="Current connection engine (click to switch)"
                                  IsEnabled="{Binding CanChangeMethod}"
                                  MinWidth="140"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Height="2"
                                 Value="{Binding ConnectingProgress, Mode=OneWay}"
                                 Maximum="100"
                                 IsIndeterminate="False"
                                 Foreground="{StaticResource Brand.AccentBrush}"
                                 Background="Transparent"
                                 Margin="0,0,0,6"
                                 Visibility="{Binding ShowConnectingProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Grid HorizontalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Width" Value="194" />
                                <Setter Property="Height" Value="194" />
                                <Setter Property="Margin" Value="0,12,0,14" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Width" Value="224" />
                                        <Setter Property="Height" Value="224" />
                                        <Setter Property="Margin" Value="0,24,0,26" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Ellipse Stroke="{Binding State, Converter={StaticResource StateToConnectBrush}}"
                                 StrokeThickness="1"
                                 Opacity="0.2">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Width" Value="194" />
                                    <Setter Property="Height" Value="194" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Width" Value="224" />
                                            <Setter Property="Height" Value="224" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Foreground="{StaticResource Brand.AccentBrush}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
                                    <Setter Property="Width" Value="184" />
                                    <Setter Property="Height" Value="184" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Width" Value="214" />
                                            <Setter Property="Height" Value="214" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>

                        <Button Command="{Binding ToggleConnectionCommand}"
                                Content="{Binding State, Converter={StaticResource StateToButtonText}}"
                                Background="{Binding State, Converter={StaticResource StateToConnectBrush}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource UI.ConnectButton}">
                                    <Setter Property="Width" Value="180" />
                                    <Setter Property="Height" Value="180" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Width" Value="206" />
                                            <Setter Property="Height" Value="206" />
                                            <Setter Property="FontSize" Value="15" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource Surface.SubtleBg}"
                            BorderBrush="{StaticResource Brand.AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6"
                            Visibility="{Binding ShowProxyBadge, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="All connection traffic is dialed through this upstream proxy">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="13" Height="13"
                                                     VerticalAlignment="Center"
                                                     Foreground="{StaticResource Brand.AccentBrush}" />
                            <TextBlock Text="Proxy:" Margin="6,0,4,0"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProxyDisplay}"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Brand.AccentBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="340" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Surface.CardSecondaryBg}"
                            BorderBrush="{DynamicResource Surface.CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Padding" Value="14,9" />
                                <Setter Property="Margin" Value="0,10,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Padding" Value="18,14" />
                                        <Setter Property="Margin" Value="0,18,0,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <UniformGrid Rows="1">

                            <StackPanel Margin="8,1,8,1" VerticalAlignment="Center">
                                <TextBlock Text="LOCATION"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Image Width="18" Height="12" Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="Linear"
                                           Visibility="{Binding HasRegion, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Source="{Binding ServerRegionCode, Converter={StaticResource CountryCodeToFlag}}" />
                                    <TextBlock Text="{Binding ServerRegionName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="8,1,8,1" VerticalAlignment="Center">
                                <TextBlock Text="UPTIME"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="{Binding UptimeText}"
                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Margin="8,1,8,1" VerticalAlignment="Center">
                                <TextBlock Text="DOWNLOAD"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <materialDesign:PackIcon Kind="ArrowDown" Width="12" Height="12"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource Brand.AccentBrush}" />
                                    <TextBlock Text="{Binding TotalDownText}"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="8,1,8,1" VerticalAlignment="Center">
                                <TextBlock Text="UPLOAD"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <materialDesign:PackIcon Kind="ArrowUp" Width="12" Height="12"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource Brand.PrimaryBrush}" />
                                    <TextBlock Text="{Binding TotalUpText}"
                                               FontFamily="Cascadia Mono, Consolas, monospace"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource UI.Card}"
                        Margin="0"
                        Padding="14,12"
                        Visibility="{Binding ShowRegionPicker, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Earth" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brand.AccentBrush}" />
                                <TextBlock Text="{Binding RegionPickerTitle}"
                                           Margin="7,0,0,0"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ComboBox Grid.Row="1"
                                  Style="{StaticResource UI.CustomComboBox}"
                                  ItemsSource="{Binding EgressRegions}"
                                  SelectedValue="{Binding SelectedEgressRegion, Mode=TwoWay}"
                                  SelectedValuePath="Code"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  MinHeight="38"
                                  Height="38"
                                  VerticalAlignment="Center"
                                  ToolTip="Select exit location country">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <materialDesign:PackIcon Kind="LightningBolt" Width="14" Height="14"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{StaticResource Brand.AccentBrush}"
                                                                 Visibility="{Binding Code, Converter={StaticResource AutoRegionToVisibility}}" />

                                        <Image Width="18" Height="12" Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="Linear"
                                               Visibility="{Binding Code, Converter={StaticResource NotAutoRegionToVisibility}}"
                                               Source="{Binding Code, Converter={StaticResource CountryCodeToFlag}}" />

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Padding="14,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource UI.Card}">
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowRegionPicker}" Value="False">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ShieldLockOutline" Width="15" Height="15"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource Brand.PrimaryBrush}" />
                                <TextBlock Text="System Tunnel (TUN)"
                                           Margin="7,0,0,0"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{DynamicResource Surface.SubtleBg}"
                                BorderBrush="{DynamicResource Surface.SubtleBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,0,10,0"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                             Fill="{Binding TunStatusBrush}" />
                                    <TextBlock Text="{Binding TunStatusText}"
                                               Margin="8,0,0,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource CompactToggleSwitch}"
                                              IsChecked="{Binding TunModeEnabled, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAdminElevated}"
                                              VerticalAlignment="Center"
                                              ToolTip="Route all system traffic through Se7en Pro (requires Administrator)" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource UI.Card}" Padding="16,12" Margin="0,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource UI.SectionTitle}" Text="Local Proxy Endpoints" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Height="34" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HTTP"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource UI.MonoPill}" Height="34" Padding="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource UI.MonoText}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding HttpProxyEndpoint}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="2"
                                    Style="{StaticResource UI.IconButton}"
                                    Width="32" Height="32"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copy HTTP proxy endpoint"
                                    Command="{Binding CopyHttpProxyCommand}">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <Grid Grid.Column="2" Height="34" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SOCKS5"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource UI.MonoPill}" Height="34" Padding="10,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource UI.MonoText}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Text="{Binding SocksProxyEndpoint}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Button Grid.Column="2"
                                    Style="{StaticResource UI.IconButton}"
                                    Width="32" Height="32"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Copy SOCKS5 proxy endpoint"
                                    Command="{Binding CopySocksProxyCommand}">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Grid>

                    <Grid Height="34" Margin="0,10,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasRouteIp, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RouteIpLabel}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource UI.MonoPill}" Height="34" Padding="10,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource UI.MonoText}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding CurrentRouteIp}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RouteIpTooltip}" />
                        </Border>
                        <Button Grid.Column="2"
                                Style="{StaticResource UI.IconButton}"
                                Width="32" Height="32"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Copy current edge IP"
                                Command="{Binding CopyCurrentIpCommand}">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                        </Button>
                    </Grid>

                    <Grid Height="34" Margin="0,10,0,0" VerticalAlignment="Center"
                          Visibility="{Binding HasRouteSni, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding RouteSniLabel}"
                                   FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource UI.MonoPill}" Height="34" Padding="10,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource UI.MonoText}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding CurrentRouteSni}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding RouteSniTooltip}" />
                        </Border>
                        <Button Grid.Column="2"
                                Style="{StaticResource UI.IconButton}"
                                Width="32" Height="32"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Copy route SNI / mode"
                                Command="{Binding CopyCurrentSniCommand}">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
