<Window x:Class="Se7enPro.Views.CloseConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Se7en Pro"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UI.FontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Border Background="#FF14141E"
            BorderBrush="#FF2A2A3E"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22,20"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.65" Color="Black" />
        </Border.Effect>

        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40" Height="40" CornerRadius="10"
                        Background="#1800D4FF"
                        BorderBrush="#3300D4FF"
                        BorderThickness="1"
                        Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="ExitToApp" Width="22" Height="22"
                                             Foreground="{StaticResource Brand.AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Close Se7en Pro?"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="What would you like to do?"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="#FF181826"
                    BorderBrush="#FF252538"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,10"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnMinimizeRowClicked">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E1E30" />
                                <Setter Property="BorderBrush" Value="#4400D4FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="34" Height="34" CornerRadius="8"
                            Background="#1800D4FF"
                            Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="ArrowDownDropCircleOutline"
                                                 Width="18" Height="18"
                                                 Foreground="{StaticResource Brand.AccentBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Minimize to system tray"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Keep Se7en Pro running in the background."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="2"
                                             Kind="ChevronRight"
                                             Width="18" Height="18"
                                             Foreground="#64748B"
                                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border Background="#FF181826"
                    BorderBrush="#FF252538"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,12"
                    Margin="0,0,0,14"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnExitRowClicked">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E1E30" />
                                <Setter Property="BorderBrush" Value="#44EF4444" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="34" Height="34" CornerRadius="8"
                            Background="#18EF4444"
                            Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="CloseCircleOutline"
                                                 Width="18" Height="18"
                                                 Foreground="#EF4444"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Close completely"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Disconnect the tunnel and exit Se7en Pro."
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="2"
                                             Kind="ChevronRight"
                                             Width="18" Height="18"
                                             Foreground="#64748B"
                                             VerticalAlignment="Center" />
                </Grid>
            </Border>

            <CheckBox x:Name="RememberCheckBox"
                      Style="{StaticResource UI.DarkCheckBox}"
                      Content="Remember my choice (don't ask again)"
                      Margin="0,0,0,16" />

            <Grid>
                <Button x:Name="CancelButton"
                        Style="{StaticResource UI.GhostButton}"
                        Background="{DynamicResource Surface.SubtleBg}"
                        BorderBrush="{DynamicResource Surface.SubtleBorder}"
                        BorderThickness="1"
                        Content="Cancel"
                        HorizontalAlignment="Right"
                        Padding="22,0" Height="36"
                        Click="OnCancelClicked"
                        IsCancel="True" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
