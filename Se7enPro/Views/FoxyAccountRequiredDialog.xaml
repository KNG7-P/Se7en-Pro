<Window x:Class="Se7enPro.Views.FoxyAccountRequiredDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{DynamicResource Loc_foxyAccountRequiredTitle}"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UI.FontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="18" GlassFrameThickness="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Surface.CardElevated}"
            BorderBrush="{DynamicResource Surface.CardBorder}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24,22"
            Margin="12"
            MouseLeftButtonDown="OnDialogBorderMouseLeftButtonDown">
        <StackPanel>
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Status.FoxySoft}" BorderBrush="{DynamicResource Status.FoxyBorder}" BorderThickness="1" Margin="0,0,14,0">
                    <materialDesign:PackIcon Kind="Firefox" Width="24" Height="24" Foreground="{DynamicResource Status.Foxy}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc_foxyAccountRequiredTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="{DynamicResource Loc_foxyAccountRequiredSubtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{DynamicResource Loc_foxyAccountRequiredDesc}"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="0,0,0,20" />

            <Border Height="1" Background="{DynamicResource Surface.CardBorder}" Margin="0,0,0,16" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Style="{StaticResource UI.GhostButton}"
                        Content="{DynamicResource Loc_dialogCancel}"
                        MinWidth="90"
                        Margin="0,0,10,0"
                        Click="OnCancelClicked"
                        IsCancel="True" />

                <Button Grid.Column="2"
                        Style="{StaticResource UI.PrimaryButton}"
                        MinWidth="180"
                        Click="OnGoToSettingsClicked"
                        IsDefault="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CogOutline" Width="15" Height="15" Foreground="{DynamicResource TextOnCyanBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="{DynamicResource Loc_foxyGoToSettings}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextOnCyanBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
