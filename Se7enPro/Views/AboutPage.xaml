<UserControl x:Class="Se7enPro.Views.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:vm="clr-namespace:Se7enPro.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Stretch" Margin="24,0,24,24">

            
            <Border Style="{StaticResource UI.Card}" CornerRadius="16" Padding="24,28" Margin="0,0,0,14">
                <StackPanel HorizontalAlignment="Center">
                    
                    <Border Width="76" Height="76" CornerRadius="22" HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00D4FF" Offset="0.0" />
                                <GradientStop Color="#7B2CBF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <materialDesign:PackIcon Kind="ShieldLock" Width="40" Height="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    
                    <TextBlock Text="{DynamicResource Loc_aboutTitle}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" />

                    
                    <Border CornerRadius="8" Background="#2200D4FF" BorderBrush="#4400D4FF" BorderThickness="1" Padding="12,6" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brand.AccentBrush}" />
                            <TextBlock Text="{DynamicResource Loc_WindowsEdition2}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Brand.AccentBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>

                    
                    <TextBlock Text="{DynamicResource Loc_Nextgenerationcensorshipcircumvent}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource UI.Card}" CornerRadius="16" Padding="20,18" Margin="0,0,0,14">
                <StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="LinkVariant" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Loc_CommunitySourceCode}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    
                    <Button Style="{StaticResource UI.CardButton}" Command="{Binding OpenGitHubCommand}" AutomationProperties.Name="{DynamicResource Loc_Se7enProRepository}">                    <Border CornerRadius="12" Padding="14,11" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Cursor="Hand" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                        <Setter Property="BorderBrush" Value="#6600D4FF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#2200D4FF" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Github" Width="18" Height="18" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_Se7enProRepository}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_githubcomKNG7PSe7enProReleasesSour}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Button>

                    
                    <Button Style="{StaticResource UI.CardButton}" Command="{Binding OpenTelegramCommand}" AutomationProperties.Name="{DynamicResource Loc_telegramChannel}">                    <Border CornerRadius="12" Padding="14,11" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Cursor="Hand" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                        <Setter Property="BorderBrush" Value="#66229ED9" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#22229ED9" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Send" Width="17" Height="17" Foreground="#229ED9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_telegramChannel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Kingnetwork7NewsConfigsCommunity}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Button>

                    
                    <Button Style="{StaticResource UI.CardButton}" Command="{Binding OpenPsiphonCoreGitHubCommand}" AutomationProperties.Name="{DynamicResource Loc_PsiphonTunnelCore}">                    <Border CornerRadius="12" Padding="14,11" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Cursor="Hand" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                        <Setter Property="BorderBrush" Value="#668B5CF6" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#228B5CF6" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CodeTags" Width="18" Height="18" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_PsiphonTunnelCore}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_UpstreamGoEnginegithubcomPsiphonLa}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Button>

                    
                    <Button Style="{StaticResource UI.CardButton}" Command="{Binding OpenInfoLinkCommand}" AutomationProperties.Name="{DynamicResource Loc_PsiphonOfficialWebsite}">                    <Border CornerRadius="12" Padding="14,11" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                        <Setter Property="BorderBrush" Value="#6610B981" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#2210B981" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Web" Width="18" Height="18" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_PsiphonOfficialWebsite}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Visitpsiphoncaforguidesdocumentati}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Button>
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource UI.Card}" CornerRadius="16" Padding="20,18" Margin="0,0,0,14">
                <StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="HelpCircleOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Loc_FAQPrivacyPolicies}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    
                    <Button Style="{StaticResource UI.CardButton}" Command="{Binding OpenFaqCommand}" AutomationProperties.Name="{DynamicResource Loc_FrequentlyAskedQuestions}">                    <Border CornerRadius="12" Padding="14,11" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Cursor="Hand" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                        <Setter Property="BorderBrush" Value="#66F59E0B" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#22F59E0B" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CommentQuestionOutline" Width="18" Height="18" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_FrequentlyAskedQuestions}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_TroubleshootingbestpracticesusageF}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Button>

                    
                    <Button Style="{StaticResource UI.CardButton}" Command="{Binding OpenPrivacyCommand}" AutomationProperties.Name="{DynamicResource Loc_PrivacyPolicySecurity}">                    <Border CornerRadius="12" Padding="14,11" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Cursor="Hand">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                        <Setter Property="BorderBrush" Value="#66F43F5E" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#22F43F5E" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="#F43F5E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc_PrivacyPolicySecurity}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Informationcollectedsecurityservic}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <materialDesign:PackIcon Grid.Column="2" Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    </Button>
                </StackPanel>
            </Border>

            
            <Border Style="{StaticResource UI.Card}" CornerRadius="16" Padding="20,18">
                <StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="Memory" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{DynamicResource Loc_TechnologyStack}" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    
                    <WrapPanel>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource Loc_PsiphonGoCore}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource Loc_logsWarp}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="MASQUE / HTTP3" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource Loc_WireGuardProtocol}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource Loc_TorOnionRouting}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="Ultrasurf / UltraCore" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="{DynamicResource Loc_SHARDProtocolXray}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="WPF .NET 8 Runtime" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="CommunityToolkit MVVM" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="8" Padding="12,6" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Margin="0,0,8,8">
                            <TextBlock Text="Material Design Themes" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
