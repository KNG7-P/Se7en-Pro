                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding TorLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding TorHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" AutomationProperties.Name="{Binding TorLabel}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AetherTor, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Tor Relays Sub-option (Only when Tor is enabled) -->
                    <Border Padding="0,8" Visibility="{Binding AetherTor, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Bridge" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding TorRelaysLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding TorRelaysHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleButton Grid.Column="2" AutomationProperties.Name="{Binding TorRelaysLabel}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AetherTorRelays, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Exit Country Recheck Interval (conditional) -->
                    <Border Padding="0,8" Visibility="{Binding HasAetherExitLoc, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="TimerOutline" Width="16" Height="16" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{Binding ExitLocSecsLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding ExitLocSecsHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Style="{StaticResource UI.CustomTextBox}" Height="36"
                                     FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="12"
                                     Text="{Binding AetherExitLocSecs, UpdateSourceTrigger=LostFocus}"
                                     materialDesign:HintAssist.Hint="60"
                                     AutomationProperties.Name="{Binding ExitLocSecsLabel}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>


            
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsTorTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Incognito" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_torOptionsTitle}" />
                            <TextBlock Style="{StaticResource Settings.SectionSubtitle}" Text="{DynamicResource Loc_Configurebridgesobfs4andPluggableT}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource UI.FieldLabel}" Text="{DynamicResource Loc_torPresetsTitle}" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Meek CDN77" Command="{Binding ApplyMeekCdn77Command}" Style="{StaticResource UI.Btn.Accent}" Padding="12,0" Margin="0,0,8,6" FontSize="11.5" />
                        <Button Content="Snowflake CDN77" Command="{Binding ApplySnowflakeCdn77Command}" Style="{StaticResource UI.Btn.Accent}" Padding="12,0" Margin="0,0,8,6" FontSize="11.5" />
                        <Button Content="{DynamicResource Loc_obfs4Antitiming}" Command="{Binding ApplyObfs4IatCommand}" Style="{StaticResource UI.Btn.Accent}" Padding="12,0" Margin="0,0,8,6" FontSize="11.5" />
                        <Button Content="{DynamicResource Loc_obfs4Public}" Command="{Binding ApplyObfs4PublicCommand}" Style="{StaticResource UI.Btn.Accent}" Padding="12,0" Margin="0,0,8,6" FontSize="11.5" />
                        <Button Content="{DynamicResource Loc_clearLogs}" Command="{Binding ClearTorBridgesCommand}" Style="{StaticResource UI.Btn.Danger}" Padding="12,0" Margin="0,0,8,6" FontSize="11.5" />
                    </WrapPanel>

                    <TextBox Text="{Binding TorBridges, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" Height="110" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderBrushDefault}" BorderThickness="1" Padding="10,8" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="12" materialDesign:HintAssist.Hint="{DynamicResource Loc_torBridgesInputHint}" AutomationProperties.Name="{DynamicResource Loc_torBridgesInputHint}" />
                    <TextBlock Style="{StaticResource UI.FieldHelper}" Text="{DynamicResource Loc_torBridgesFootnote}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>


    </Grid>
    </materialDesign:DialogHost>
</UserControl>
