                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Loc_lanAccessAuth}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_Requirecredentialsforlocalnetworkd}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_lanAccessAuth}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding LanAuthEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Border Margin="0,6,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Visibility="{Binding LanAuthEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#26A855F7" CornerRadius="6" Padding="5" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="ShieldLockOutline" Width="13" Height="13" Foreground="#C084FC" />
                                    </Border>
                                    <TextBlock Text="{DynamicResource Loc_lanAccessAuth}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <Border Grid.Column="2" Background="{DynamicResource Surface.CardBg}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Loc_optionalBadge}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <materialDesign:PackIcon Kind="AccountOutline" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_lanUsername}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42" Text="{Binding LanProxyUsername, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_Username}" AutomationProperties.Name="{DynamicResource Loc_lanUsername}" />
                                </StackPanel>

                                
                                <StackPanel Grid.Column="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                        <materialDesign:PackIcon Kind="LockOutline" Width="13" Height="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{DynamicResource Loc_lanPassword}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42" Text="{Binding LanProxyPassword, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_Password}" AutomationProperties.Name="{DynamicResource Loc_lanPassword}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    
                    <Border Padding="0,9">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{DynamicResource Loc_allowLan}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{DynamicResource Loc_ShareproxywithdevicesonyourWiFiorL}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_allowLan}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AllowLanConnections, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    
                    <Border Margin="0,6,0,0" Padding="14" CornerRadius="12" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Visibility="{Binding AllowLanConnections, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#34D399" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Loc_lanEndpointsTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{DynamicResource Loc_lanWifiClients}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </Grid>

                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                
                                <Border Grid.Row="0" Grid.Column="0" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanHostIp}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding HostLanIp}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopyHostIpCommand}" ToolTip="{DynamicResource Loc_CopyHostIP}" AutomationProperties.Name="{DynamicResource Loc_CopyHostIP}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHostIpCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>

                                
                                <Border Grid.Row="0" Grid.Column="2" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanSocks5Endpoint}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanSocksEndpoint}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopySocksEndpointCommand}" ToolTip="{DynamicResource Loc_CopySOCKS5Endpoint}" AutomationProperties.Name="{DynamicResource Loc_CopySOCKS5Endpoint}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSocksEndpointCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>

                                
                                <Border Grid.Row="2" Grid.Column="0" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanHttpEndpoint}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanHttpEndpoint}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopyHttpEndpointCommand}" ToolTip="{DynamicResource Loc_CopyHTTPProxyEndpoint2}" AutomationProperties.Name="{DynamicResource Loc_CopyHTTPProxyEndpoint2}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHttpEndpointCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>

                                
                                <Border Grid.Row="2" Grid.Column="2" Height="42" Padding="10,4" CornerRadius="9" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_lanAuthUserPass}" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding LanAuthDisplay}" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Settings.CopyButton}" Command="{Binding CopyAuthCommand}" IsEnabled="{Binding HasLanAuthCredentials}" Visibility="{Binding HasLanAuthCredentials, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{DynamicResource Loc_CopyAuthenticationCredentials}" AutomationProperties.Name="{DynamicResource Loc_CopyAuthenticationCredentials}">
                                            <materialDesign:PackIcon Width="15" Height="15">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="ContentCopy" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brand.AccentBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAuthCopied}" Value="True">
                                                                <Setter Property="Kind" Value="Check" />
                                                                <Setter Property="Foreground" Value="#FF34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            
<!-- Custom DNS. Placed below the local-proxy section because it is a
                 network setting like that section, not a routing one. -->
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsNetworkTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch">

                    <!-- header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Dns" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{Binding Dns.Labels.CardTitle}" />
                            <TextBlock Text="{Binding Dns.Labels.CardSubtitle}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="#2600D4FF" BorderBrush="#4000D4FF" BorderThickness="1" CornerRadius="6" Padding="8,3.5" VerticalAlignment="Top" Margin="10,1,0,0">
                            <TextBlock Text="{Binding Dns.Summary}" FontSize="10.5" FontWeight="Bold" Foreground="#00D4FF" />
                        </Border>
                    </Grid>

                    <!-- The three resolver lists. One template drives all of them, so the
                         transports cannot drift apart visually. -->
                    <ItemsControl ItemsSource="{Binding Dns.Rows}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="0,0,0,8" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DnsFieldRow}">
                                <Border Padding="12,10" CornerRadius="10"
                                        Background="{DynamicResource Surface.SubtleBg}"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Surface.SubtleBorder}" />
                                            <Style.Triggers>
                                                <!-- Amber only when something entered will be
                                                     ignored, so the colour means something. -->
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#66F59E0B" />
                                                    <Setter Property="Background" Value="#14F59E0B" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:DnsFieldState.Ok}">
                                                    <Setter Property="BorderBrush" Value="#4D34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" Background="#2634D399" BorderBrush="#5034D399" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{Binding HasEntries, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding CountText}" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                            </Border>
                                        </Grid>

                                        <TextBox Style="{StaticResource UI.CustomTextBox}" Height="38" FontFamily="{StaticResource UI.MonoFontFamily}" FontSize="12"
                                                 Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 materialDesign:HintAssist.Hint="{Binding Placeholder}"
                                                 AutomationProperties.Name="{Binding Label}" />

                                        <!-- Guidance only while the field is empty; once it has
                                             entries the example in the placeholder is enough. -->
                                        <TextBlock Text="{Binding Hint}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,5,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                        <StackPanel Orientation="Horizontal" Margin="2,5,0,0"
                                                    Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="12" Height="12" Foreground="#F59E0B" Margin="0,1,5,0" />
                                            <TextBlock Text="{Binding Problem}" FontSize="10.5" Foreground="#F59E0B" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- strict mode -->
                    <Border Padding="0,4">
                        <StackPanel>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Dns.Labels.StrictLabel}" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dns.StrictMode}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Dns.Labels.StrictLabelOn}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Dns.Labels.StrictHint}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleButton Grid.Column="1" AutomationProperties.Name="{Binding Dns.Labels.StrictLabel}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding Dns.StrictMode, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Strict mode with only encrypted resolvers leaves the TUN
                                 forwarder with nothing to dial, so it would silently break DNS
                                 for any app resolving through the adapter. -->
                            <Border Margin="0,10,0,0" Padding="11,9" CornerRadius="8" Background="#20F59E0B" BorderBrush="#40F59E0B" BorderThickness="1"
                                    Visibility="{Binding Dns.HasTunnelWarning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Text="{Binding Dns.Labels.TunnelWarning}" TextWrapping="Wrap" FontSize="11.5" Foreground="#F59E0B" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- footer -->
                    <Border Padding="12" Margin="0,12,0,0" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Style="{StaticResource UI.Btn.Primary}" Padding="14,0" Margin="0,0,8,0"
                                        Command="{Binding Dns.TestResolversCommand}"
                                        IsEnabled="{Binding Dns.CanTest, Converter={StaticResource InverseBool}}"
                                        AutomationProperties.Name="{Binding Dns.Labels.TestLabel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Stethoscope" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dns.Labels.TestLabel}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Style="{StaticResource UI.Btn.Danger}" Padding="12,0"
                                        Command="{Binding Dns.ResetCommand}"
                                        AutomationProperties.Name="{Binding Dns.Labels.ResetLabel}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Restore" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Dns.Labels.ResetLabel}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Confirmation that the auto-save landed. No Save button,
                                     because there is nothing left to press. -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding Dns.IsSavedFlash, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Foreground="#34D399" Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding Dns.Labels.AutoSaved}" FontSize="11.5" FontWeight="SemiBold" Foreground="#34D399" />
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="8" Background="#2022C55E" BorderBrush="#4022C55E" BorderThickness="1"
                                    Visibility="{Binding Dns.HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Dns.ValidationMessage}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" Foreground="#22C55E" />
                            </Border>

                            <TextBlock Margin="0,8,0,0" Text="{Binding Dns.TestResult}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding Dns.HasTestResultToShow, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsAetherTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
