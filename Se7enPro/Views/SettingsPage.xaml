<UserControl x:Class="Se7enPro.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:conv="clr-namespace:Se7enPro.Converters" xmlns:svc="clr-namespace:Se7enPro.Services" xmlns:vm="clr-namespace:Se7enPro.ViewModels" xmlns:controls="clr-namespace:Se7enPro.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:CountryCodeToFlagSourceConverter x:Key="CountryCodeToFlag" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <conv:StringEqualsConverter x:Key="StringEquals" />
        <conv:StringToBrushConverter x:Key="HexToBrush" />

        
        <Style x:Key="Settings.SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UI.FontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="Settings.SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UI.FontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        
        <Style x:Key="Settings.Card" TargetType="Border" BasedOn="{StaticResource UI.Card}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <DataTemplate x:Key="CountryItemTemplate" DataType="{x:Type svc:Country}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:CountryFlag CountryCode="{Binding Code}" FlagWidth="24" FlagHeight="16" FlagCornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="SettingsTabButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource Tab.RestBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Tab.RestBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" TextElement.Foreground="{TemplateBinding Foreground}" CornerRadius="10" Padding="4,0" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Tab.HoverBg}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Tab.HoverBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Tab.HoverText}" />
                            </Trigger>
                            
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Tab.SelectedBg}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Tab.SelectedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedText}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Tab.SelectedBg}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource Tab.SelectedBorder}" />
                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedText}" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Settings.CopyButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <materialDesign:DialogHost IsOpen="{Binding IsCoreUpdateSuccessDialogOpen, Mode=TwoWay}" CloseOnClickAway="False" OverlayBackground="#99000000" DialogBackground="Transparent" DialogTheme="Inherit">

        <materialDesign:DialogHost.DialogContent>
            <Border MaxWidth="440" HorizontalAlignment="Center" CornerRadius="16" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.CardBorder}" BorderThickness="1" Padding="26,24">
                <StackPanel HorizontalAlignment="Stretch">
                    
                    <Border Width="52" Height="52" CornerRadius="26" Background="#1800E5FF" BorderBrush="#3300E5FF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="28" Height="28" Foreground="{StaticResource Brand.AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding CoreUpdateSuccessTitle}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding CoreUpdateSuccessMessage}" FontSize="13" LineHeight="20" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,22" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource UI.GhostButton}" Content="{DynamicResource Loc_close}" Command="{Binding CloseCoreUpdateSuccessDialogCommand}" />

                        <Button Grid.Column="2" Style="{StaticResource UI.PrimaryButton}" Content="{DynamicResource Loc_restartNow}" Command="{Binding RestartApplicationCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            
            
            <Border Grid.Row="0" Margin="24,0,32,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    
                    <RadioButton Grid.Column="0" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="General" Checked="OnSettingsTabChecked" Tag="{Binding IsGeneralTab}" IsChecked="{Binding IsGeneralTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabGeneral}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Tune" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGeneralTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabGeneral}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>

                    
                    <RadioButton Grid.Column="2" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="Network" Checked="OnSettingsTabChecked" Tag="{Binding IsNetworkTab}" IsChecked="{Binding IsNetworkTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabNetwork}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Lan" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNetworkTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabNetwork}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>

                    
                    <RadioButton Grid.Column="4" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="Psiphon" Checked="OnSettingsTabChecked" Tag="{Binding IsPsiphonTab}" IsChecked="{Binding IsPsiphonTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabPsiphon}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPsiphonTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabPsiphon}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>

                    
                    <RadioButton Grid.Column="6" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="Aether" Checked="OnSettingsTabChecked" Tag="{Binding IsAetherTab}" IsChecked="{Binding IsAetherTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabAether}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="LightningBolt" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAetherTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabAether}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>

                    
                    <RadioButton Grid.Column="8" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="Tor" Checked="OnSettingsTabChecked" Tag="{Binding IsTorTab}" IsChecked="{Binding IsTorTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabTor}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="WeatherNight" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTorTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabTor}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>

                    
                    <RadioButton Grid.Column="10" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="Shard" Checked="OnSettingsTabChecked" Tag="{Binding IsShardTab}" IsChecked="{Binding IsShardTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabShard}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ShareVariantOutline" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShardTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabShard}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>

                    
                    <RadioButton Grid.Column="12" Style="{StaticResource SettingsTabButtonStyle}" CommandParameter="Chained" Checked="OnSettingsTabChecked" Tag="{Binding IsChainedTab}" IsChecked="{Binding IsChainedTab, Mode=OneWay}" AutomationProperties.Name="{DynamicResource Loc_tabChained}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChainedTab}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Tab.SelectedIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{DynamicResource Loc_tabChained}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>
                </Grid>
            </Border>

            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
                <StackPanel HorizontalAlignment="Stretch" Margin="24,0,24,30">

                    
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="PaletteOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" /><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_sectionAppearanceLocale}" /></StackPanel>
                            </Grid>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_appearanceMode}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_appearanceModeDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Key" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_appearanceMode}" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_languageLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Selectyourpreferredapplicationlang}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Key" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_languageLabel}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Monitor" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" /><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_sectionSystemStartup}" /></StackPanel>
                            </Grid>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_autoConnectLaunch}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Automaticallyinitiatetunnelconnect}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_autoConnectLaunch}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding AutoConnect, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_startWithWindows}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_LaunchSe7enProsilentlyatsystemstar}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_startWithWindows}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_MinimizetoTray2}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Keeprunninginbackgroundnotificatio}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" AutomationProperties.Name="{DynamicResource Loc_MinimizetoTray2}" Style="{StaticResource MaterialDesignSwitchToggleButton}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            
                            <Border Padding="0,9">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{DynamicResource Loc_Whenclosingwindow}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_Choosethedefaultactionwhenclicking}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource UI.CustomComboBox}" Width="180" Height="36" ItemsSource="{Binding CloseActions}" SelectedItem="{Binding SelectedCloseAction}" DisplayMemberPath="Display" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc_Whenclosingwindow}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    
                    <Border Style="{StaticResource Settings.Card}" Visibility="{Binding IsGeneralTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Stretch">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" Foreground="{StaticResource Brand.AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" /><StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{DynamicResource Loc_maintenanceTitle}" /></StackPanel>
                            </Grid>

                            
                            <Border Padding="12" Margin="0,0,0,10" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#2400D4FF" BorderBrush="#4000D4FF" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Cached" Width="18" Height="18" Foreground="#00D4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Loc_resetCache}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{DynamicResource Loc_resetCacheDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource UI.Btn.Warning}" Padding="14,0" Command="{Binding ClearNetworkCacheCommand}" IsEnabled="{Binding IsClearingCache, Converter={StaticResource InverseBool}}" AutomationProperties.Name="{DynamicResource Loc_resetCache}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Cached" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Loc_resetCache}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            
                            <Border Padding="12" CornerRadius="10" Background="{DynamicResource Surface.SubtleBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="#24EF4444" BorderBrush="#40EF4444" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Restore" Width="18" Height="18" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{DynamicResource Loc_resetSettings}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
