                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource Surface.CardBg}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" CornerRadius="5" Padding="5,1.5">
                                            <TextBlock Text="1–65535" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                    <TextBox Style="{StaticResource UI.CustomTextBox}" Height="42" Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="{DynamicResource Loc_108090Auto}" AutomationProperties.Name="{DynamicResource Loc_108090Auto}" />
                                </StackPanel>
                            </Grid>

                            
                            <Border Margin="0,10,0,0" Padding="10,6" CornerRadius="6" Background="#20EF4444" BorderBrush="#60EF4444" BorderThickness="1" Visibility="{Binding HasPortCollision, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0" />
