<UserControl x:Class="Se7enPro.Controls.CountryFlag" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Name="Root">
    <Border x:Name="FlagBorder" Width="{Binding FlagWidth, ElementName=Root}" Height="{Binding FlagHeight, ElementName=Root}" CornerRadius="{Binding FlagCornerRadius, ElementName=Root}" BorderBrush="{DynamicResource Surface.SubtleBorder}" BorderThickness="1" Background="{DynamicResource Surface.SubtleBg}" SnapsToDevicePixels="True">
        
        <materialDesign:PackIcon x:Name="AutoIcon" Kind="LightningBolt" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Brand.AccentBrush}" />
    </Border>
</UserControl>
