<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <NoWarn>$(NoWarn);WFAC010;NU1900</NoWarn>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Se7enPro</RootNamespace>
    <AssemblyName>Se7enPro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Platforms>x64;x86;AnyCPU</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86' or '$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x86' and '$(RuntimeIdentifier)' != 'win-x86'">x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <RollForward>LatestMajor</RollForward>
    <Version>1.0.8</Version>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <FileVersion>1.0.8.0</FileVersion>
    <Product>Se7en Pro</Product>
    <Company>Se7en Pro</Company>
    <Authors>Se7en Pro</Authors>
    <PublisherName>Se7en Pro</PublisherName>
    <Description>Se7en Pro - modern Windows client</Description>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup>
    <Se7enGeneratedSecrets>$(MSBuildThisFileDirectory)Services\BuildSecrets.g.cs</Se7enGeneratedSecrets>
    <Se7enServerEntries>$(MSBuildThisFileDirectory)Resources\server_entries.bin</Se7enServerEntries>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(Se7enGeneratedSecrets)') AND '$(DesignTimeBuild)' != 'true'">
    <DefineConstants>$(DefineConstants);SE7EN_SECRETS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Resources\psiphon-tunnel-core.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\server_entries.txt" Condition="Exists('Resources\server_entries.txt')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\server_entries.bin" Condition="Exists('Resources\server_entries.bin')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="$(Se7enServerEntries)" Condition="Exists('$(Se7enServerEntries)')">
      <LogicalName>Se7enPro.Resources.server_entries.bin</LogicalName>
    </EmbeddedResource>

    <Content Include="Resources\tun2socks\tun2socks.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\tun2socks\wintun.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\zeptun\zeptun.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\zeptun\wintun.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\zeptun\LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\mihomo\mihomo.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\mihomo\wintun.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\aether\aether.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\tor\tor.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\tor\pluggable_transports\lyrebird.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\tor\pluggable_transports\conjure-client.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\tor\data\geoip">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\tor\data\geoip6">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\shard\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\xray\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\sing_box\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\lantern\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\veep\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <Content Include="Resources\foxy\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <Resource Include="Resources\Flags\*.png" />
    <Content Include="Resources\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Fonts\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- The engines (aether, tor, xray, sing-box, tun2socks, psiphon) are launched as
       separate processes from AppContext.BaseDirectory\Resources, so they have to stay
       real files next to the exe. Without this, single-file publishing folds every
       .exe/.dll into the bundle and the app cannot find them at runtime. -->
  <ItemGroup>
    <Content Update="Resources\**" ExcludeFromSingleFile="true" />
    <None Update="Resources\**" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- ==================================================================================
       Isolated "split debug" configuration.

       Build it with the SplitDebug configuration for win-x64 (see BUILDING.md for the
       exact command lines).

       It exists so the split-tunnel work can be installed and tested next to a normal
       installation of Se7en Pro without touching it. Everything that identifies the
       installation is separated:
           * AssemblyName      -> Se7enPro.SplitDebug   (own exe, own process name)
           * Product           -> Se7en Pro (Split Debug)
           * ISOLATED_DEBUG    -> own %LocalAppData% folder, own single-instance identity,
                                  own autostart registry value, own WFP sublayer GUIDs
           * Version           -> 1.0.8.1 so Windows shows it as a different build
       The runtime behaviour of the split tunnel is identical to Release.
       ================================================================================== -->
  <PropertyGroup Condition="'$(Configuration)' == 'SplitDebug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);ISOLATED_DEBUG;DEBUG</DefineConstants>
    <AssemblyName>Se7enPro.SplitDebug</AssemblyName>
    <Product>Se7en Pro (Split Debug)</Product>
    <Description>Se7en Pro - isolated split-tunnel debug build</Description>
    <AssemblyTitle>Se7en Pro (Split Debug)</AssemblyTitle>
    <Version>1.0.8.1</Version>
    <AssemblyVersion>1.0.8.1</AssemblyVersion>
    <FileVersion>1.0.8.1</FileVersion>
    <InformationalVersion>1.0.8.1-splitdebug</InformationalVersion>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

</Project>
