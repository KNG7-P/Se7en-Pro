    <Style x:Key="UI.DarkCheckBox" TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDefault}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="materialDesign:RippleAssist.IsDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        
                        <Border x:Name="BoxOuter" Grid.Column="0" Width="19" Height="19" CornerRadius="5" Background="{DynamicResource Surface.CardSecondaryBg}" BorderBrush="{DynamicResource Surface.CardBorderStrong}" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,10,0" SnapsToDevicePixels="True">
                            
                            <materialDesign:PackIcon x:Name="CheckIcon" Kind="Check" Width="13" Height="13" Foreground="{DynamicResource TextOnCyanBrush}" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BoxOuter" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            <Setter TargetName="BoxOuter" Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="BoxOuter" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                            <Setter TargetName="BoxOuter" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                            <Setter TargetName="CheckIcon" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource UI.DarkCheckBox}" />


    
    
    
    <Style x:Key="UI.NavItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="Margin" Value="10,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    
                    <Grid>
                        <Border x:Name="HoverBd" CornerRadius="12" Opacity="0" Background="{DynamicResource Surface.HoverBg}" BorderBrush="{DynamicResource Surface.CardBorderStrong}" BorderThickness="1" />
                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="HoverBd" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.NavSelectedBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Surface.NavSelectedBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.NavSelectedBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Surface.NavSelectedBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    <Style x:Key="UI.NavItemIcon" TargetType="materialDesign:PackIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Nav.SelectedIcon}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    
    
    
    <Style x:Key="UI.TelegramButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brand.TelegramSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand.TelegramBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.TelegramHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brand.TelegramBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brand.TelegramGradient}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    
    
    
    <Style x:Key="UI.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrushDefault}" />
        <Setter Property="Margin" Value="0,12,0,12" />
    </Style>

    <Style x:Key="UI.SegmentedPill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Background" Value="{DynamicResource BgInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Surface.CardBorderStrong}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.NavSelectedBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Surface.NavSelectedBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.NavSelectedBg}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Surface.NavSelectedBorder}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UI.DataGridCellRight" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,0,8,0" />
    </Style>

