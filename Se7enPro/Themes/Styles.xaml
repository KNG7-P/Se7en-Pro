    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <ControlTemplate.Resources>
                        <conv:ScrollBarPillGeometryConverter x:Key="PillGeometryVertical" />
                    </ControlTemplate.Resources>
                    <Grid Background="Transparent">
                        <Border x:Name="OuterBg" Background="Transparent" CornerRadius="5" />
                        <Border x:Name="Pill" Background="{DynamicResource BorderBrushHover}" CornerRadius="4" Opacity="0.75" IsHitTestVisible="False">
                            <Border.Margin>
                                <MultiBinding Converter="{StaticResource PillGeometryVertical}">
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                    <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                    <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                </MultiBinding>
                            </Border.Margin>
                        </Border>
                        <Track Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeatTransparent}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollRepeatTransparent}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBg" Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                            <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <ControlTemplate.Resources>
                                <conv:ScrollBarPillGeometryConverter x:Key="PillGeometryHorizontal" Horizontal="True" />
                            </ControlTemplate.Resources>
                            <Grid Background="Transparent">
                                <Border x:Name="OuterBg" Background="Transparent" CornerRadius="5" />
                                <Border x:Name="Pill" Background="{DynamicResource BorderBrushHover}" CornerRadius="4" Opacity="0.75" IsHitTestVisible="False">
                                    <Border.Margin>
                                        <MultiBinding Converter="{StaticResource PillGeometryHorizontal}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                            <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                            <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                            <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                            <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" Mode="OneWay" />
                                        </MultiBinding>
                                    </Border.Margin>
                                </Border>
                                <Track Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyleHorizontal}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollRepeatTransparent}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollRepeatTransparent}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterBg" Property="Background" Value="{DynamicResource Surface.HoverBg}" />
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource AccentCyanBrush}" />
                                    <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    
    
    
